{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"tsx src/index.ts\"",
    "build": "tsup",
    "build:client": "vite build --mode production",
    "start": "node dist/index.js",
    "typecheck": "tsc --project tsconfig.api.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "ml:test": "cd ml_service && pytest -q",
    "ci": "pnpm prisma generate && pnpm typecheck && pnpm lint && pnpm test && pnpm run build:client && pnpm ml:test",
    "check": "tsc --project tsconfig.api.json --noEmit",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "audit:infra": "tsx scripts/repo-audit.ts",
    "scan:secrets": "./scripts/scan-secrets.sh",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "vite --config vite.config.ts --port 3000",
    "dev:ml": "uvicorn ml_service.app.main:app --host 0.0.0.0 --port 8000",
    "dev:worker:hp": "cd ml_service && celery -A workers.celery_app worker --queues=high_priority,default --loglevel=info --concurrency=2",
    "dev:worker:ml": "cd ml_service && celery -A workers.celery_app worker --queues=ml_jobs --loglevel=info --concurrency=1",
    "dev:beat": "cd ml_service && celery -A workers.celery_app beat --loglevel=info",
    "dev:replit": "concurrently -k -n BE,FE,ML,HP,MLQ,BEAT \"npm:dev:backend\" \"npm:dev:frontend\" \"npm:dev:ml\" \"npm:dev:worker:hp\" \"npm:dev:worker:ml\" \"npm:dev:beat\"",
    "prepare": "husky"
  },
