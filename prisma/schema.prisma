generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TenantPlan {
  TRIAL
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum UserRole {
  ADMIN
  MANAGER
  SALES
  SALES_MANAGER
  FINANCE
  FI_MANAGER
  SERVICE
  BDC
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum PreferredContactMethod {
  EMAIL
  PHONE
  SMS
}

enum LeadSource {
  WEBSITE
  REFERRAL
  WALKIN
  WALK_IN
  PHONE
  EMAIL
  SOCIAL_MEDIA
  THIRD_PARTY
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  SCHEDULED
  NEGOTIATION
  WON
  HOT
  WARM
  COLD
  LOST
  CUSTOMER
  ARCHIVED
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  SMS
  TASK
  MEETING
  VISIT
  TEST_DRIVE
  FOLLOW_UP
}

enum ActivityStatus {
  PENDING
  COMPLETED
  CANCELED
  SKIPPED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum AppointmentType {
  TEST_DRIVE
  DELIVERY
  FINANCE
  SERVICE
  OTHER
}

enum CommunicationType {
  CALL
  SMS
  EMAIL
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
}

enum CommunicationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

enum InteractionType {
  CALL
  EMAIL
  SMS
  VISIT
  TEST_DRIVE
  FOLLOW_UP
}

enum InteractionDirection {
  INBOUND
  OUTBOUND
}

enum CustomerVehicleStatus {
  OWNED
  TRADED
  SOLD
}

enum VehicleType {
  NEW
  USED
  CERTIFIED
}

enum FuelType {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
}

enum VehicleStatus {
  AVAILABLE
  PENDING
  SOLD
  IN_TRANSIT
  SERVICE
  WHOLESALE
}

enum VehicleHistoryType {
  SERVICE
  ACCIDENT
  OWNERSHIP
  INSPECTION
}

enum DealType {
  CASH
  FINANCE
  LEASE
}

enum DealStatus {
  DRAFT
  PENDING
  SUBMITTED
  APPROVED
  FUNDED
  DELIVERED
  CANCELLED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum JournalStatus {
  DRAFT
  POSTED
  VOID
}

enum LineType {
  DEBIT
  CREDIT
}

enum CommissionType {
  FRONT
  BACK
  BONUS
  SPIFF
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CHARGEBACK
}

enum ReportType {
  SALES
  INVENTORY
  FINANCE
  CUSTOM
}

enum NotificationType {
  DEAL_APPROVAL
  FOLLOW_UP
  INVENTORY_ALERT
  TASK
  SYSTEM
}

enum AutomationExecutionStatus {
  SUCCESS
  FAILED
  SKIPPED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW
}

model Tenant {
  id                 String       @id @default(cuid())
  name               String
  subdomain          String       @unique
  plan               TenantPlan   @default(BASIC)
  status             TenantStatus @default(ACTIVE)
  settings           Json         @default(dbgenerated("'{}'::jsonb"))
  billingEmail       String
  subscriptionEndsAt DateTime?    @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(6)

  users                User[]
  customers            Customer[]
  customerInteractions CustomerInteraction[]
  customerVehicles     CustomerVehicle[]
  leads                Lead[]
  activities           Activity[]
  appointments         Appointment[]
  leadScores           LeadScore[]
  communications       Communication[]
  emailTemplates       EmailTemplate[]
  smsTemplates         SMSTemplate[]
  automations          Automation[]
  automationExecutions AutomationExecution[]
  vehicles             Vehicle[]
  vehicleHistories     VehicleHistory[]
  deals                Deal[]
  dealJackets          DealJacket[]
  creditApplications   CreditApplication[]
  creditReports        CreditReport[]
  lenders              Lender[]
  lenderSubmissions    LenderSubmission[]
  contracts            Contract[]
  fundingChecklists    FundingChecklist[]
  glAccounts           GLAccount[]
  journalEntries       JournalEntry[]
  journalEntryLines    JournalEntryLine[]
  commissions          Commission[]
  reports              Report[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  systemSettings       SystemSetting[]
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  email        String
  password     String
  firstName    String
  lastName     String
  phone        String?
  role         UserRole   @default(SALES)
  permissions  Json       @default(dbgenerated("jsonb_build_array()"))
  status       UserStatus @default(ACTIVE)
  isSuperAdmin Boolean    @default(false)
  lastLoginAt  DateTime?  @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime?  @db.Timestamptz(6)

  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customers             Customer[]            @relation("CustomerAssignedTo")
  interactions          CustomerInteraction[]
  leadsAssigned         Lead[]                @relation("LeadAssignedTo")
  leadsOwned            Lead[]                @relation("LeadOwner")
  activities            Activity[]
  appointments          Appointment[]        @relation("AppointmentAssignedTo")
  communications        Communication[]
  dealsAsSales          Deal[]                @relation("SalesPersonDeals")
  dealsAsFinance        Deal[]                @relation("FinanceManagerDeals")
  dealJacketsAsSales    DealJacket[]          @relation("DealJacketSalesperson")
  dealJacketsAsFinance  DealJacket[]          @relation("DealJacketFIManager")
  fundingChecklistsReviewed FundingChecklist[] @relation("FundingChecklistReviewer")
  journalEntries        JournalEntry[]
  commissions           Commission[]
  reports               Report[]              @relation("ReportCreatedBy")
  notifications         Notification[]
  auditLogs             AuditLog[]
  systemSettings        SystemSetting[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([isSuperAdmin])
}

model Customer {
  id                     String                   @id @default(cuid())
  tenantId               String
  firstName              String
  lastName               String
  email                  String?
  phone                  String?
  mobile                 String?
  dateOfBirth            DateTime?                @db.Date
  driversLicenseNumber   String?
  driversLicenseState    String?
  ssn                    String?
  addressStreet          String?
  addressCity            String?
  addressState           String?
  addressZip             String?
  addressCountry         String?
  preferredContactMethod PreferredContactMethod   @default(EMAIL)
  leadSource             LeadSource               @default(WEBSITE)
  leadStatus             LeadStatus               @default(NEW)
  leadScore              Int                      @default(0)
  creditScore            Int?
  assignedToUserId       String?
  tags                   String[]                 @default([])
  notes                  String?
  lifetimeValue          Decimal                  @default(0) @db.Decimal(18, 2)
  createdAt              DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                 @updatedAt @db.Timestamptz(6)
  deletedAt              DateTime?                @db.Timestamptz(6)
  searchVector           Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english', coalesce(\"firstName\",'') || ' ' || coalesce(\"lastName\",'') || ' ' || coalesce(\"email\",'') || ' ' || coalesce(\"phone\",''))")) @map("search_vector")

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedToUser User?                 @relation("CustomerAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  interactions   CustomerInteraction[]
  leads          Lead[]
  activities     Activity[]
  appointments   Appointment[]
  communications Communication[]
  vehicles       CustomerVehicle[]
  deals          Deal[]
  dealJackets    DealJacket[]

  @@index([tenantId, leadStatus])
  @@index([tenantId, assignedToUserId])
  @@index([searchVector], type: Gin)
  @@index([tenantId, lastName, firstName])
}

model CustomerInteraction {
  id          String               @id @default(cuid())
  tenantId    String
  customerId  String
  userId      String
  type        InteractionType
  direction   InteractionDirection
  subject     String?
  notes       String?
  duration    Int?
  scheduledAt DateTime?            @db.Timestamptz(6)
  completedAt DateTime?            @db.Timestamptz(6)
  createdAt   DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime?            @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@index([tenantId, scheduledAt])
}

model Lead {
  id                  String       @id @default(cuid())
  tenantId            String
  customerId          String?
  assignedToId        String?
  ownerId             String?
  firstName           String?
  lastName            String?
  email               String?
  phone               String?
  status              LeadStatus   @default(NEW)
  source              LeadSource   @default(WEBSITE)
  priority            LeadPriority @default(MEDIUM)
  rating              Int?
  score               Int?
  smsOptOut           Boolean      @default(false)
  emailOptOut         Boolean      @default(false)
  callOptOut          Boolean      @default(false)
  isArchived          Boolean      @default(false)
  isConverted         Boolean      @default(false)
  lastActivityAt      DateTime?    @db.Timestamptz(6)
  lastCommunicationAt DateTime?    @db.Timestamptz(6)
  nextActionAt        DateTime?    @db.Timestamptz(6)
  convertedAt         DateTime?    @db.Timestamptz(6)
  description         String?
  tags                String[]     @default([])
  createdAt           DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo     User?           @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  owner          User?           @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities     Activity[]
  appointments   Appointment[]
  communications Communication[]
  scores         LeadScore[]

  @@index([tenantId, status])
  @@index([tenantId, assignedToId])
  @@index([tenantId, ownerId])
  @@index([tenantId, source])
  @@index([tenantId, isArchived, status])
  @@index([tenantId, createdAt])
}

model Activity {
  id          String         @id @default(cuid())
  tenantId    String
  leadId      String?
  customerId  String?
  userId      String?
  type        ActivityType
  status      ActivityStatus @default(PENDING)
  subject     String?
  description String?
  outcome     String?
  metadata   Json?
  opened     Boolean      @default(false)
  clicked    Boolean      @default(false)
  dueAt       DateTime?      @db.Timestamptz(6)
  startedAt   DateTime?      @db.Timestamptz(6)
  completedAt DateTime?      @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead           Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  communications Communication[]
  followUpForAppointment Appointment? @relation("AppointmentFollowUpTask")

  @@index([tenantId, leadId])
  @@index([tenantId, userId])
  @@index([tenantId, dueAt])
  @@index([tenantId, status])
}

model Appointment {
  id            String            @id @default(cuid())
  tenantId      String
  leadId        String?
  customerId    String?
  assignedToId  String?
  vehicleId     String?
  title         String
  notes         String?
  type          AppointmentType
  status        AppointmentStatus @default(SCHEDULED)
  location      String?
  timeZone      String?           @default("UTC")
  startAt       DateTime          @db.Timestamptz(6)
  endAt         DateTime?         @db.Timestamptz(6)
  checkedInAt   DateTime?         @db.Timestamptz(6)
  completedAt   DateTime?         @db.Timestamptz(6)
  cancelledAt   DateTime?         @db.Timestamptz(6)
  noShowAt      DateTime?         @db.Timestamptz(6)
  outcome       String?
  followUpTaskId String? @unique
  createdAt     DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(6)

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo User?     @relation("AppointmentAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  vehicle    Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  followUpTask Activity? @relation("AppointmentFollowUpTask", fields: [followUpTaskId], references: [id], onDelete: SetNull)

  @@index([tenantId, startAt])
  @@index([tenantId, status])
  @@index([tenantId, leadId])
  @@index([tenantId, assignedToId])
  @@index([tenantId, vehicleId])
}

model LeadScore {
  id         String   @id @default(cuid())
  tenantId   String
  leadId     String
  modelKey   String
  score      Int
  scoreDelta Int?
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId])
  @@index([tenantId, createdAt])
}

model Communication {
  id         String                 @id @default(cuid())
  tenantId   String
  type       CommunicationType
  direction  CommunicationDirection
  to         String
  from       String
  subject    String?
  body       String?
  providerId String?
  status     CommunicationStatus?
  metadata   Json?
  leadId     String?
  customerId String?
  activityId String?
  userId     String?
  createdAt  DateTime               @default(now()) @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, type])
  @@index([tenantId, leadId])
  @@index([tenantId, createdAt])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  subject   String
  html      String
  text      String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, updatedAt])
}

model SMSTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  body      String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, updatedAt])
}

model Automation {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  trigger   Json
  actions   Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  executions AutomationExecution[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model AutomationExecution {
  id           String                     @id @default(cuid())
  tenantId     String
  automationId String?
  triggerType  String
  status       AutomationExecutionStatus @default(SUCCESS)
  context      Json?
  result       Json?
  error        String?
  startedAt    DateTime                   @default(now()) @db.Timestamptz(6)
  completedAt  DateTime?                  @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  automation Automation? @relation(fields: [automationId], references: [id], onDelete: SetNull)

  @@index([tenantId, triggerType])
  @@index([tenantId, automationId])
}

model CustomerVehicle {
  id             String                @id @default(cuid())
  tenantId       String
  customerId     String
  vin            String
  year           Int
  make           String
  model          String
  trim           String?
  purchaseDate   DateTime?             @db.Timestamptz(6)
  purchasePrice  Decimal?              @db.Decimal(18, 2)
  currentMileage Int?
  status         CustomerVehicleStatus @default(OWNED)
  tradedInDate   DateTime?             @db.Timestamptz(6)
  notes          String?
  createdAt      DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(6)

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tradeDeals Deal[]   @relation("TradeVehicleDeal")

  @@unique([tenantId, vin])
  @@index([tenantId, customerId])
}

model Vehicle {
  id                    String                   @id @default(cuid())
  tenantId              String
  stockNumber           String
  vin                   String
  type                  VehicleType
  year                  Int
  make                  String
  model                 String
  trim                  String?
  exteriorColor         String?
  interiorColor         String?
  mileage               Int?
  engineType            String?
  transmission          String?
  drivetrain            String?
  fuelType              FuelType
  msrp                  Decimal?                 @db.Decimal(18, 2)
  invoiceCost           Decimal?                 @db.Decimal(18, 2)
  listPrice             Decimal?                 @db.Decimal(18, 2)
  specialPrice          Decimal?                 @db.Decimal(18, 2)
  status                VehicleStatus            @default(AVAILABLE)
  location              String?
  dateReceived          DateTime?                @db.Timestamptz(6)
  dateSold              DateTime?                @db.Timestamptz(6)
  daysInStock           Int?                     @default(0)
  images                String[]                 @default([])
  features              String[]                 @default([])
  certificationNumber   String?
  floorPlanId           String?
  floorPlanDate         DateTime?                @db.Timestamptz(6)
  floorPlanInterestRate Decimal?                 @db.Decimal(5, 2)
  notes                 String?
  createdAt             DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                 @updatedAt @db.Timestamptz(6)
  deletedAt             DateTime?                @db.Timestamptz(6)
  searchVector          Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english', coalesce(\"vin\",'') || ' ' || coalesce(\"make\",'') || ' ' || coalesce(\"model\",''))")) @map("search_vector")

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deals     Deal[]
  dealJackets DealJacket[]
  histories VehicleHistory[]
  appointments Appointment[]

  @@unique([tenantId, stockNumber])
  @@unique([vin])
  @@index([tenantId, status])
  @@index([tenantId, make, model])
  @@index([searchVector], type: Gin)
}

model VehicleHistory {
  id          String             @id @default(cuid())
  tenantId    String
  vehicleId   String
  type        VehicleHistoryType
  date        DateTime           @db.Timestamptz(6)
  description String
  documentUrl String?
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([tenantId, vehicleId])
}

model Deal {
  id               String     @id @default(cuid())
  tenantId         String
  dealNumber       String
  customerId       String
  vehicleId        String
  salesPersonId    String
  financeManagerId String?
  dealType         DealType
  status           DealStatus @default(DRAFT)
  vehiclePrice     Decimal    @db.Decimal(18, 2)
  discount         Decimal    @default(0) @db.Decimal(18, 2)
  netVehiclePrice  Decimal    @db.Decimal(18, 2)
  tradeVehicleId   String?
  tradeAllowance   Decimal?   @db.Decimal(18, 2)
  tradePayoff      Decimal?   @db.Decimal(18, 2)
  tradeEquity      Decimal?   @db.Decimal(18, 2)
  downPayment      Decimal?   @db.Decimal(18, 2)
  amountFinanced   Decimal?   @db.Decimal(18, 2)
  apr              Decimal?   @db.Decimal(5, 2)
  term             Int?
  monthlyPayment   Decimal?   @db.Decimal(18, 2)
  lenderName       String?
  lenderRate       Decimal?   @db.Decimal(5, 2)
  dealerReserve    Decimal?   @db.Decimal(18, 2)
  docFee           Decimal?   @db.Decimal(18, 2)
  registrationFee  Decimal?   @db.Decimal(18, 2)
  salesTax         Decimal?   @db.Decimal(18, 2)
  otherFees        Json?
  warrantyProduct  String?
  warrantyCost     Decimal?   @db.Decimal(18, 2)
  gapInsurance     Boolean    @default(false)
  gapCost          Decimal?   @db.Decimal(18, 2)
  maintenancePlan  Boolean    @default(false)
  maintenanceCost  Decimal?   @db.Decimal(18, 2)
  otherProducts    Json?
  frontEndGross    Decimal?   @db.Decimal(18, 2)
  backEndGross     Decimal?   @db.Decimal(18, 2)
  totalGross       Decimal?   @db.Decimal(18, 2)
  packAmount       Decimal?   @db.Decimal(18, 2)
  dealDate         DateTime   @db.Timestamptz(6)
  fundedDate       DateTime?  @db.Timestamptz(6)
  deliveryDate     DateTime?  @db.Timestamptz(6)
  notes            String?
  createdAt        DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime?  @db.Timestamptz(6)

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle        Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  salesPerson    User             @relation("SalesPersonDeals", fields: [salesPersonId], references: [id], onDelete: Restrict)
  financeManager User?            @relation("FinanceManagerDeals", fields: [financeManagerId], references: [id], onDelete: SetNull)
  tradeVehicle   CustomerVehicle? @relation("TradeVehicleDeal", fields: [tradeVehicleId], references: [id], onDelete: SetNull)
  journalEntries JournalEntry[]
  commissions    Commission[]

  @@unique([tenantId, dealNumber])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, salesPersonId])
}

model DealJacket {
  id                String   @id @default(uuid())
  tenantId          String
  dealNumber        String   @unique
  customerId        String
  vehicleId         String
  salespersonId     String
  fiManagerId       String?
  sellingPrice      Decimal  @db.Decimal(18, 2)
  tradeValue        Decimal? @db.Decimal(18, 2)
  tradePayoff       Decimal? @db.Decimal(18, 2)
  netTrade          Decimal? @db.Decimal(18, 2)
  cashDown          Decimal  @db.Decimal(18, 2)
  amountFinanced    Decimal  @db.Decimal(18, 2)
  lenderId          String?
  lender            Lender?  @relation("DealJacketLender", fields: [lenderId], references: [id], onDelete: SetNull)
  apr               Decimal? @db.Decimal(6, 3)
  term              Int?
  monthlyPayment    Decimal? @db.Decimal(18, 2)
  fiProducts        Json
  totalFiGross      Decimal? @db.Decimal(18, 2)
  status            String
  dealDate          DateTime @default(now())
  contractDate      DateTime?
  fundedDate        DateTime?
  deliveredDate     DateTime?
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle           Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  salesperson       User     @relation("DealJacketSalesperson", fields: [salespersonId], references: [id], onDelete: Restrict)
  fiManager         User?    @relation("DealJacketFIManager", fields: [fiManagerId], references: [id], onDelete: SetNull)
  creditApplication CreditApplication?
  lenderSubmissions LenderSubmission[]
  documents         DealDocument[]
  contracts         Contract[]
  fundingChecklist  FundingChecklist?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
  @@index([customerId])
  @@index([status])
}

model DealDocument {
  id         String     @id @default(uuid())
  dealId     String
  type       String
  category   String
  name       String
  fileName   String
  fileUrl    String
  mimeType   String
  fileSize   Int
  uploadedBy String
  uploadedAt DateTime   @default(now())
  deal       DealJacket @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([type])
}

model CreditApplication {
  id                String   @id @default(uuid())
  tenantId          String
  dealId            String   @unique
  firstName         String
  middleName        String?
  lastName          String
  ssn               String
  dateOfBirth       DateTime
  phone             String
  email             String
  currentStreet     String
  currentCity       String
  currentState      String
  currentZip        String
  yearsAtAddress    Int
  monthsAtAddress   Int
  residenceType     String
  monthlyPayment    Decimal? @db.Decimal(18, 2)
  previousStreet    String?
  previousCity      String?
  previousState     String?
  previousZip       String?
  employer          String
  jobTitle          String
  yearsEmployed     Int
  monthsEmployed    Int
  monthlyIncome     Decimal  @db.Decimal(18, 2)
  employerPhone     String
  otherIncomeSource String?
  otherIncomeAmount Decimal? @db.Decimal(18, 2)
  coApplicant       Json?
  references        Json
  authorizeCredit   Boolean
  certifyAccuracy   Boolean
  privacyConsent    Boolean
  signature         String?
  signedAt          DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal              DealJacket @relation(fields: [dealId], references: [id], onDelete: Cascade)
  creditReport      CreditReport?

  @@index([tenantId])
  @@index([dealId])
}

model CreditReport {
  id                     String   @id @default(uuid())
  tenantId               String
  creditApplicationId    String   @unique
  bureau                 String
  pullType               String
  experianScore          Int?
  transUnionScore        Int?
  equifaxScore           Int?
  mergedScore            Int?
  scoreRange             String?
  totalAccounts          Int
  openAccounts           Int
  totalRevolvingCredit   Decimal  @db.Decimal(18, 2)
  totalRevolvingBalance  Decimal  @db.Decimal(18, 2)
  utilizationPercent     Decimal  @db.Decimal(5, 2)
  totalInstallmentDebt   Decimal  @db.Decimal(18, 2)
  monthlyDebtObligations Decimal  @db.Decimal(18, 2)
  onTimePaymentPercent   Decimal  @db.Decimal(5, 2)
  late30Days             Int
  late60Days             Int
  late90PlusDays         Int
  collections            Int
  chargeOffs             Int
  bankruptcies           Int
  foreclosures           Int
  hardInquiries          Int
  softInquiries          Int
  tradeLines             Json
  rawResponse            Json
  pdfUrl                 String?
  pulledBy               String
  pulledAt               DateTime @default(now())
  creditApplication      CreditApplication @relation(fields: [creditApplicationId], references: [id], onDelete: Cascade)
  tenant                 Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([creditApplicationId])
}

model Lender {
  id             String             @id @default(uuid())
  tenantId       String
  name           String
  type           String
  apiProvider    String
  apiCredentials Json
  isActive       Boolean            @default(true)
  tierRange      String
  maxTerm        Int
  maxLtv         Decimal            @db.Decimal(6, 3)
  minCreditScore Int?
  maxCreditScore Int?
  applicationFee Decimal?           @db.Decimal(18, 2)
  submissions    LenderSubmission[]
  fundedDeals    DealJacket[]       @relation("DealJacketLender")
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model LenderSubmission {
  id              String        @id @default(uuid())
  tenantId        String
  dealId          String
  lenderId        String
  submittedAt     DateTime      @default(now())
  submittedBy     String
  requestPayload  Json
  status          String
  respondedAt     DateTime?
  responsePayload Json?
  amountApproved  Decimal?      @db.Decimal(18, 2)
  apr             Decimal?      @db.Decimal(6, 3)
  buyRate         Decimal?      @db.Decimal(6, 3)
  dealerReserve   Decimal?      @db.Decimal(6, 3)
  maxReserve      Decimal?      @db.Decimal(6, 3)
  term            Int?
  monthlyPayment  Decimal?      @db.Decimal(18, 2)
  declineReason   String?
  declineCode     String?
  stipulations    Json?
  isSelected      Boolean       @default(false)
  selectedAt      DateTime?
  expiresAt       DateTime?
  deal            DealJacket    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lender          Lender        @relation(fields: [lenderId], references: [id], onDelete: Cascade)
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([dealId])
  @@index([status])
}

model Contract {
  id             String   @id @default(uuid())
  tenantId       String
  dealId         String
  contractNumber String
  status         String
  documentUrl    String?
  executedAt     DateTime?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal           DealJacket @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([dealId])
  @@unique([dealId, contractNumber])
}

model FundingChecklist {
  id         String   @id @default(uuid())
  tenantId   String
  dealId     String   @unique
  items      Json
  completed  Boolean  @default(false)
  completedAt DateTime?
  reviewerId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal       DealJacket @relation(fields: [dealId], references: [id], onDelete: Cascade)
  reviewer   User?     @relation("FundingChecklistReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  @@index([tenantId])
}

model GLAccount {
  id              String        @id @default(cuid())
  tenantId        String
  accountNumber   String
  accountName     String
  accountType     AccountType
  normalBalance   NormalBalance
  parentAccountId String?
  isActive        Boolean       @default(true)
  balance         Decimal?      @db.Decimal(18, 2)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentAccount GLAccount?         @relation("GLAccountHierarchy", fields: [parentAccountId], references: [id], onDelete: SetNull)
  subAccounts   GLAccount[]        @relation("GLAccountHierarchy")
  journalLines  JournalEntryLine[]

  @@unique([tenantId, accountNumber])
  @@index([tenantId, parentAccountId])
}

model JournalEntry {
  id          String        @id @default(cuid())
  tenantId    String
  entryNumber String
  memo        String?
  status      JournalStatus @default(DRAFT)
  postingDate DateTime      @db.Timestamptz(6)
  dealId      String?
  postedById  String
  postedAt    DateTime?     @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal     Deal?              @relation(fields: [dealId], references: [id], onDelete: SetNull)
  postedBy User               @relation(fields: [postedById], references: [id], onDelete: Restrict)
  lines    JournalEntryLine[]

  @@unique([tenantId, entryNumber])
  @@index([tenantId, dealId])
}

model JournalEntryLine {
  id             String   @id @default(cuid())
  tenantId       String
  journalEntryId String
  glAccountId    String
  type           LineType
  amount         Decimal  @db.Decimal(18, 2)
  description    String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  glAccount    GLAccount    @relation(fields: [glAccountId], references: [id], onDelete: Restrict)

  @@index([tenantId, journalEntryId])
  @@index([tenantId, glAccountId])
}

model Commission {
  id             String           @id @default(cuid())
  tenantId       String
  dealId         String
  userId         String
  commissionType CommissionType
  amount         Decimal          @db.Decimal(18, 2)
  rate           Decimal?         @db.Decimal(5, 2)
  status         CommissionStatus @default(PENDING)
  paidDate       DateTime?        @db.Timestamptz(6)
  notes          String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, status])
}

model Report {
  id          String     @id @default(cuid())
  tenantId    String
  name        String
  type        ReportType
  parameters  Json?
  schedule    String?
  lastRunAt   DateTime?  @db.Timestamptz(6)
  createdById String
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User   @relation("ReportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([tenantId, type])
}

model Notification {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  type      NotificationType
  title     String
  message   String
  actionUrl String?
  isRead    Boolean          @default(false)
  readAt    DateTime?        @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, isRead])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  resource  String
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, resource])
  @@index([tenantId, userId])
}

model SystemSetting {
  id          String   @id @default(cuid())
  tenantId    String
  key         String
  value       Json
  updatedById String
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedBy User   @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([tenantId, key])
  @@index([tenantId])
}
