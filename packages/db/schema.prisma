  dealId          String     @unique @map("deal_id")
  tenantId        String     @map("tenant_id")
  state           String
  federalItems    Json       @map("federal_items")
  stateItems      Json       @map("state_items")
  lenderItems     Json       @map("lender_items")
  internalItems   Json       @map("internal_items")
  completedItems  Int        @map("completed_items")
  totalItems      Int        @map("total_items")
  percentComplete Decimal    @map("percent_complete") @db.Decimal(5, 2)
  isComplete      Boolean    @default(false) @map("is_complete")
  completedAt     DateTime?  @map("completed_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deal            DealJacket @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([dealId])
  @@map("compliance_checklists")
}

model CreditApplication {
  id                String        @id @default(uuid())
  tenantId          String        @map("tenant_id")
  dealId            String        @unique @map("deal_id")
  firstName         String        @map("first_name")
  middleName        String?       @map("middle_name")
  lastName          String        @map("last_name")
  ssn               String
  dateOfBirth       DateTime      @map("date_of_birth")
  phone             String
  email             String
  currentStreet     String        @map("current_street")
  currentCity       String        @map("current_city")
  currentState      String        @map("current_state")
  currentZip        String        @map("current_zip")
  yearsAtAddress    Int           @map("years_at_address")
  monthsAtAddress   Int           @map("months_at_address")
  residenceType     String        @map("residence_type")
  monthlyPayment    Decimal?      @map("monthly_payment") @db.Decimal(18, 2)
  previousStreet    String?       @map("previous_street")
  previousCity      String?       @map("previous_city")
  previousState     String?       @map("previous_state")
  previousZip       String?       @map("previous_zip")
  employer          String
  jobTitle          String        @map("job_title")
  yearsEmployed     Int           @map("years_employed")
  monthsEmployed    Int           @map("months_employed")
  monthlyIncome     Decimal       @map("monthly_income") @db.Decimal(18, 2)
  employerPhone     String        @map("employer_phone")
  otherIncomeSource String?       @map("other_income_source")
  otherIncomeAmount Decimal?      @map("other_income_amount") @db.Decimal(18, 2)
  coApplicant       Json?         @map("co_applicant")
  references        Json
  authorizeCredit   Boolean       @map("authorize_credit")
  certifyAccuracy   Boolean       @map("certify_accuracy")
  privacyConsent    Boolean       @map("privacy_consent")
  signature         String?
  signedAt          DateTime?     @map("signed_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deal              DealJacket    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creditReport      CreditReport?

  @@index([tenantId])
  @@index([dealId])
  @@map("credit_applications")
}

model CreditReport {
  id                     String            @id @default(uuid())
  tenantId               String            @map("tenant_id")
  creditApplicationId    String            @unique @map("credit_application_id")
  bureau                 String
  pullType               String            @map("pull_type")
  experianScore          Int?              @map("experian_score")
  transUnionScore        Int?              @map("trans_union_score")
  equifaxScore           Int?              @map("equifax_score")
  mergedScore            Int?              @map("merged_score")
  scoreRange             String?           @map("score_range")
  totalAccounts          Int               @map("total_accounts")
  openAccounts           Int               @map("open_accounts")
  totalRevolvingCredit   Decimal           @map("total_revolving_credit") @db.Decimal(18, 2)
  totalRevolvingBalance  Decimal           @map("total_revolving_balance") @db.Decimal(18, 2)
  utilizationPercent     Decimal           @map("utilization_percent") @db.Decimal(5, 2)
  totalInstallmentDebt   Decimal           @map("total_installment_debt") @db.Decimal(18, 2)
  monthlyDebtObligations Decimal           @map("monthly_debt_obligations") @db.Decimal(18, 2)
  onTimePaymentPercent   Decimal           @map("on_time_payment_percent") @db.Decimal(5, 2)
  late30Days             Int               @map("late30_days")
  late60Days             Int               @map("late60_days")
  late90PlusDays         Int               @map("late90_plus_days")
  collections            Int
  chargeOffs             Int               @map("charge_offs")
  bankruptcies           Int
  foreclosures           Int
  hardInquiries          Int               @map("hard_inquiries")
  softInquiries          Int               @map("soft_inquiries")
  tradeLines             Json              @map("trade_lines")
  rawResponse            Json              @map("raw_response")
  pdfUrl                 String?           @map("pdf_url")
  pulledBy               String            @map("pulled_by")
  pulledAt               DateTime          @default(now()) @map("pulled_at")
  creditApplication      CreditApplication @relation(fields: [creditApplicationId], references: [id], onDelete: Cascade)
  tenant                 Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([creditApplicationId])
  @@map("credit_reports")
}

model Lender {
  id                  String               @id @default(uuid())
  tenantId            String               @map("tenant_id")
  name                String
  type                LenderType           @map("type")
  apiProvider         String               @map("api_provider")
  apiCredentials      Json                 @map("api_credentials")
  isActive            Boolean              @default(true) @map("is_active")
  tierRange           String               @map("tier_range")
  maxTerm             Int                  @map("max_term")
  maxLtv              Decimal              @map("max_ltv") @db.Decimal(6, 3)
  minCreditScore      Int?                 @map("min_credit_score")
  maxCreditScore      Int?                 @map("max_credit_score")
  applicationFee      Decimal?             @map("application_fee") @db.Decimal(18, 2)
  approvalPredictions ApprovalPrediction[]
  fundedDeals         DealJacket[]         @relation("DealJacketLender")
  deals               Deal[]               @relation("DealLender")
  submissions         LenderSubmission[]
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("lenders")
}

model LenderSubmission {
  id              String     @id @default(uuid())
  tenantId        String     @map("tenant_id")
  dealId          String     @map("deal_id")
  lenderId        String     @map("lender_id")
  submittedAt     DateTime   @default(now()) @map("submitted_at")
  submittedBy     String     @map("submitted_by")
  requestPayload  Json       @map("request_payload")
  status          String
  respondedAt     DateTime?  @map("responded_at")
  responsePayload Json?      @map("response_payload")
  amountApproved  Decimal?   @map("amount_approved") @db.Decimal(18, 2)
  apr             Decimal?   @db.Decimal(6, 3)
  buyRate         Decimal?   @map("buy_rate") @db.Decimal(6, 3)
  dealerReserve   Decimal?   @map("dealer_reserve") @db.Decimal(6, 3)
  maxReserve      Decimal?   @map("max_reserve") @db.Decimal(6, 3)
  term            Int?
  monthlyPayment  Decimal?   @map("monthly_payment") @db.Decimal(18, 2)
  declineReason   String?    @map("decline_reason")
  declineCode     String?    @map("decline_code")
  stipulations    Json?
  isSelected      Boolean    @default(false) @map("is_selected")
  selectedAt      DateTime?  @map("selected_at")
  expiresAt       DateTime?  @map("expires_at")
  deal            DealJacket @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lender          Lender     @relation(fields: [lenderId], references: [id], onDelete: Cascade)
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([dealId])
  @@index([status])
  @@map("lender_submissions")
}

model FundingChecklist {
  id          String     @id @default(uuid())
  tenantId    String     @map("tenant_id")
  dealId      String     @unique @map("deal_id")
  items       Json
  completed   Boolean    @default(false)
  completedAt DateTime?  @map("completed_at")
  reviewerId  String?    @map("reviewer_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deal        DealJacket @relation(fields: [dealId], references: [id], onDelete: Cascade)
  reviewer    User?      @relation("FundingChecklistReviewer", fields: [reviewerId], references: [id])
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("funding_checklists")
}

model FundingRequest {
  id              String     @id @default(uuid())
  dealId          String     @unique @map("deal_id")
  tenantId        String     @map("tenant_id")
  lenderId        String     @map("lender_id")
  amountRequested Decimal    @map("amount_requested") @db.Decimal(18, 2)
  fundingMethod   String     @map("funding_method")
  bankAccountId   String?    @map("bank_account_id")
  status          String
  submittedAt     DateTime?  @map("submitted_at")
  reviewedAt      DateTime?  @map("reviewed_at")
  approvedAt      DateTime?  @map("approved_at")
  fundedAt        DateTime?  @map("funded_at")
  fundedAmount    Decimal?   @map("funded_amount") @db.Decimal(18, 2)
  lenderRefNumber String?    @map("lender_ref_number")
  timeline        Json       @default("[]")
  journalEntryId  String?    @map("journal_entry_id")
  createdBy       String     @map("created_by")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deal            DealJacket @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([dealId])
  @@index([status])
  @@map("funding_requests")
}

model GLAccount {
  id                   String             @id @default(cuid())
  tenantId             String             @map("tenant_id")
  accountNumber        String             @map("account_number")
  accountName          String             @map("account_name")
  accountType          AccountType        @map("account_type")
  normalBalance        NormalBalance      @map("normal_balance")
  parentAccountId      String?            @map("parent_account_id")
  isActive             Boolean            @default(true) @map("is_active")
  balance              Decimal?           @db.Decimal(18, 2)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  parentAccount        GLAccount?         @relation("GLAccountHierarchy", fields: [parentAccountId], references: [id])
  subAccounts          GLAccount[]        @relation("GLAccountHierarchy")
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creditJournalEntries JournalEntry[]     @relation("JournalEntryCredit")
  debitJournalEntries  JournalEntry[]     @relation("JournalEntryDebit")
  journalLines         JournalEntryLine[]

  @@unique([tenantId, accountNumber])
  @@index([tenantId, parentAccountId])
  @@map("gl_accounts")
}

model JournalEntry {
  id              String             @id @default(cuid())
  tenantId        String             @map("tenant_id")
  entryNumber     String             @map("entry_number")
  memo            String?
  status          JournalStatus      @default(DRAFT)
  postingDate     DateTime           @map("posting_date") @db.Timestamptz(6)
  dealId          String?            @map("deal_id")
  postedById      String             @map("posted_by_id")
  postedAt        DateTime?          @map("posted_at") @db.Timestamptz(6)
  entryType       JournalEntryType?  @map("entry_type")
  amountCents     Int?               @map("amount_cents")
  debitAccountId  String?            @map("debit_account_id")
  creditAccountId String?            @map("credit_account_id")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  creditAccount   GLAccount?         @relation("JournalEntryCredit", fields: [creditAccountId], references: [id])
  deal            Deal?              @relation(fields: [dealId], references: [id])
  debitAccount    GLAccount?         @relation("JournalEntryDebit", fields: [debitAccountId], references: [id])
  postedBy        User               @relation(fields: [postedById], references: [id])
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines           JournalEntryLine[]

  @@unique([tenantId, entryNumber])
  @@index([tenantId, dealId])
  @@index([tenantId, entryType])
  @@index([tenantId, debitAccountId])
  @@index([tenantId, creditAccountId])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String       @id @default(cuid())
  tenantId       String       @map("tenant_id")
  journalEntryId String       @map("journal_entry_id")
  glAccountId    String       @map("gl_account_id")
  type           LineType
  amount         Decimal      @db.Decimal(18, 2)
  description    String?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  glAccount      GLAccount    @relation(fields: [glAccountId], references: [id])
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, journalEntryId])
  @@index([tenantId, glAccountId])
  @@map("journal_entry_lines")
}

model Commission {
  id             String           @id @default(cuid())
  tenantId       String           @map("tenant_id")
  dealId         String           @map("deal_id")
  userId         String           @map("user_id")
  commissionType CommissionType   @map("commission_type")
  amount         Decimal          @db.Decimal(18, 2)
  rate           Decimal?         @db.Decimal(5, 2)
  status         CommissionStatus @default(PENDING)
  paidDate       DateTime?        @map("paid_date") @db.Timestamptz(6)
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deal           Deal             @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@map("commissions")
}

model Report {
  id          String     @id @default(cuid())
  tenantId    String     @map("tenant_id")
  name        String
  type        ReportType
  parameters  Json?
  schedule    String?
  lastRunAt   DateTime?  @map("last_run_at") @db.Timestamptz(6)
  createdById String     @map("created_by_id")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   User       @relation("ReportCreatedBy", fields: [createdById], references: [id])
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, type])
  @@map("reports")
}

model Notification {
  id          String           @id @default(cuid())
  tenantId    String           @map("tenant_id")
  userId      String           @map("user_id")
  kind        String           @default("system")
  type        NotificationType
  title       String
  message     String
  actionUrl   String?          @map("action_url")
  isRead      Boolean          @default(false) @map("is_read")
  readAt      DateTime?        @map("read_at") @db.Timestamptz(6)
  payload     Json?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  priority    String?          @default("normal") @db.VarChar
  action_data Json?
  expires_at  DateTime?        @db.Timestamp(6)
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, isRead])
  @@map("notifications")
}

model WorkflowDefinition {
  id         String              @id @default(cuid())
  tenantId   String              @map("tenant_id")
  name       String
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  aggregates PipelineAggregate[]
  workflows  VehicleWorkflow[]
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages     WorkflowStage[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("workflow_definitions")
}

model WorkflowStage {
  id              String             @id @default(cuid())
  tenantId        String             @map("tenant_id")
  definitionId    String             @map("definition_id")
  key             String
  name            String
  position        Int
  slaHours        Int?               @map("sla_hours")
  wipLimit        Int?               @map("wip_limit")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  outgoing        StageTransition[]  @relation("StageTransitionFromStage")
  incoming        StageTransition[]  @relation("StageTransitionToStage")
  transportOrders TransportOrder[]
  workflows       VehicleWorkflow[]  @relation("VehicleWorkflowCurrentStage")
  definition      WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasks           WorkflowTask[]

  @@unique([tenantId, definitionId, key])
  @@index([tenantId, definitionId, position])
  @@map("workflow_stages")
}

model VehicleWorkflow {
  id              String             @id @default(cuid())
  tenantId        String             @map("tenant_id")
  vehicleId       String             @map("vehicle_id")
  definitionId    String             @map("definition_id")
  currentStageId  String?            @map("current_stage_id")
  startedAt       DateTime           @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime?          @map("completed_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  transitions     StageTransition[]
  transportOrders TransportOrder[]
  currentStage    WorkflowStage?     @relation("VehicleWorkflowCurrentStage", fields: [currentStageId], references: [id])
  definition      WorkflowDefinition @relation(fields: [definitionId], references: [id])
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle         Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tasks           WorkflowTask[]

  @@unique([tenantId, vehicleId])
  @@index([tenantId, definitionId])
  @@index([tenantId, currentStageId])
  @@map("vehicle_workflows")
}

model StageTransition {
  id          String          @id @default(cuid())
  tenantId    String          @map("tenant_id")
  workflowId  String          @map("workflow_id")
  fromStageId String?         @map("from_stage_id")
  toStageId   String          @map("to_stage_id")
  at          DateTime        @default(now()) @db.Timestamptz(6)
  byUserId    String          @map("by_user_id")
  note        String?
  actor       User            @relation("StageTransitionActor", fields: [byUserId], references: [id])
  fromStage   WorkflowStage?  @relation("StageTransitionFromStage", fields: [fromStageId], references: [id])
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  toStage     WorkflowStage   @relation("StageTransitionToStage", fields: [toStageId], references: [id])
  workflow    VehicleWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([tenantId, workflowId, at])
  @@map("stage_transitions")
}

model WorkflowTask {
  id          String             @id @default(cuid())
  tenantId    String             @map("tenant_id")
  workflowId  String             @map("workflow_id")
  stageId     String?            @map("stage_id")
  vehicleId   String             @map("vehicle_id")
  title       String
  description String?
  type        WorkflowTaskType   @default(OTHER)
  status      WorkflowTaskStatus @default(OPEN)
  dueAt       DateTime?          @map("due_at") @db.Timestamptz(6)
  assigneeId  String?            @map("assignee_id")
  tags        String[]           @default([])
  mentions    String[]           @default([])
  checklist   Json?
  costCents   Int?               @map("cost_cents")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignee    User?              @relation("WorkflowTaskAssignee", fields: [assigneeId], references: [id])
  stage       WorkflowStage?     @relation(fields: [stageId], references: [id])
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle     Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  workflow    VehicleWorkflow    @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([tenantId, vehicleId])
  @@index([tenantId, workflowId])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@map("workflow_tasks")
}

model TransportOrder {
  id             String               @id @default(cuid())
  tenantId       String               @map("tenant_id")
  workflowId     String               @map("workflow_id")
  stageId        String?              @map("stage_id")
  vehicleId      String               @map("vehicle_id")
  vendor         String?
  pickupAddress  String?              @map("pickup_address")
  dropoffAddress String?              @map("dropoff_address")
  scheduledAt    DateTime?            @map("scheduled_at") @db.Timestamptz(6)
  status         TransportOrderStatus @default(REQUESTED)
  costCents      Int?                 @map("cost_cents")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  stage          WorkflowStage?       @relation(fields: [stageId], references: [id])
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle        Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  workflow       VehicleWorkflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([tenantId, vehicleId])
  @@index([tenantId, workflowId])
  @@index([tenantId, status])
  @@map("transport_orders")
}

model PipelineAggregate {
  id                    String             @id @default(cuid())
  tenantId              String             @map("tenant_id")
  definitionId          String             @map("definition_id")
  stageKey              String             @map("stage_key")
  bucketStart           DateTime           @map("bucket_start") @db.Timestamptz(6)
  avgTimeInStageMinutes Int                @default(0) @map("avg_time_in_stage_minutes")
  completedCount        Int                @default(0) @map("completed_count")
  slaHitRate            Decimal?           @map("sla_hit_rate") @db.Decimal(5, 2)
  wipMax                Int                @default(0) @map("wip_max")
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  definition            WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, definitionId, stageKey, bucketStart])
  @@index([tenantId, bucketStart])
  @@map("pipeline_aggregates")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String?  @map("user_id")
  action    String
  resource  String
  details   Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

