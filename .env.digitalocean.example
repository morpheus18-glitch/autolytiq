# AutolytiQ - Digital Ocean Production Environment Variables
# Copy this file to .env and fill in your values

# ========================================
# Application Configuration
# ========================================
NODE_ENV=production
PORT=5000
APP_URL=https://yourdomain.com
API_URL=https://yourdomain.com

# ========================================
# Database (PostgreSQL)
# ========================================
# For self-hosted (on droplet):
DATABASE_URL=postgresql://autolytiq:YOUR_PASSWORD@localhost:5432/autolytiq?schema=public
DIRECT_URL=postgresql://autolytiq:YOUR_PASSWORD@localhost:5432/autolytiq?schema=public

# For managed database:
# DATABASE_URL=postgresql://user:password@db-postgresql-nyc3-12345.ondigitalocean.com:25060/autolytiq?sslmode=require
# DIRECT_URL=postgresql://user:password@db-postgresql-nyc3-12345.ondigitalocean.com:25060/autolytiq?sslmode=require

# ========================================
# Security (REQUIRED - Generate Strong Secrets!)
# ========================================
# Generate with: openssl rand -base64 32
SESSION_SECRET=CHANGE_THIS_TO_RANDOM_32_CHARS

# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHARS

# Generate with: openssl rand -hex 32
CREDIT_ENCRYPTION_KEY=CHANGE_THIS_TO_64_HEX_CHARS

# ========================================
# Redis (Optional - For Background Jobs)
# ========================================
# For self-hosted (on droplet):
REDIS_URL=redis://localhost:6379

# For managed Redis:
# REDIS_URL=redis://default:PASSWORD@redis-12345.ondigitalocean.com:25061

# ========================================
# Email Configuration (SendGrid)
# ========================================
SENDGRID_API_KEY=SG.xxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=AutolytiQ
# SENDGRID_WEBHOOK_SIGNING_KEY=xxxxxxxxxxxx

# Alternative: SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ========================================
# SMS Configuration (Twilio)
# ========================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxx
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+12025551234

# ========================================
# Cloud Storage (S3 or DigitalOcean Spaces)
# ========================================
# For DigitalOcean Spaces (recommended):
AWS_ACCESS_KEY_ID=your-spaces-key
AWS_SECRET_ACCESS_KEY=your-spaces-secret
AWS_REGION=nyc3
S3_BUCKET=autolytiq-prod
S3_REGION=nyc3
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_CLOUDFRONT_URL=https://autolytiq-prod.nyc3.cdn.digitaloceanspaces.com

# For AWS S3:
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_REGION=us-east-1
# S3_BUCKET=autolytiq-documents
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_CLOUDFRONT_URL=https://d1234567890.cloudfront.net

# ========================================
# AI Services (OpenAI)
# ========================================
OPENAI_API_KEY=sk-xxxxxxxxxxxx
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# ========================================
# Payment Processing (Stripe)
# ========================================
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ========================================
# OAuth Providers
# ========================================
# Google OAuth
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxx
GOOGLE_CALLBACK_URL=https://yourdomain.com/api/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=xxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxx
GITHUB_CALLBACK_URL=https://yourdomain.com/api/auth/github/callback

# Apple OAuth
APPLE_CLIENT_ID=xxxxxxxxxxxx
APPLE_TEAM_ID=xxxxxxxxxxxx
APPLE_KEY_ID=xxxxxxxxxxxx
APPLE_PRIVATE_KEY=xxxxxxxxxxxx

# ========================================
# Credit Bureau Integration (Optional)
# ========================================
EXPERIAN_API_URL=https://api.experian.com
EXPERIAN_API_KEY=xxxxxxxxxxxx
EXPERIAN_CLIENT_ID=xxxxxxxxxxxx
EXPERIAN_CLIENT_SECRET=xxxxxxxxxxxx

TRANSUNION_API_URL=https://api.transunion.com
TRANSUNION_API_KEY=xxxxxxxxxxxx

EQUIFAX_API_URL=https://api.equifax.com
EQUIFAX_API_KEY=xxxxxxxxxxxx

# ========================================
# E-Signature (DocuSign - Optional)
# ========================================
DOCUSIGN_BASE_URL=https://na3.docusign.net
DOCUSIGN_INTEGRATOR_KEY=xxxxxxxxxxxx
DOCUSIGN_USER_ID=xxxxxxxxxxxx
DOCUSIGN_AUTH_JWT=xxxxxxxxxxxx
DOCUSIGN_ACCOUNT_ID=xxxxxxxxxxxx
DOCUSIGN_REDIRECT_URL=https://yourdomain.com/api/integrations/docusign/callback

# ========================================
# Analytics (ClickHouse - Optional)
# ========================================
CLICKHOUSE_HOST=xxxxxxxxxxxx.clickhouse.cloud
CLICKHOUSE_PORT=9440
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=xxxxxxxxxxxx
CLICKHOUSE_DATABASE=autolytiq

# ========================================
# Monitoring & Error Tracking
# ========================================
# Sentry
SENTRY_DSN=https://xxxxxxxxxxxx@sentry.io/xxxxxxxxxxxx
SENTRY_ENVIRONMENT=production

# LogDNA / LogTail
LOGDNA_KEY=xxxxxxxxxxxx

# New Relic
NEW_RELIC_LICENSE_KEY=xxxxxxxxxxxx
NEW_RELIC_APP_NAME=AutolytiQ

# ========================================
# Feature Flags
# ========================================
ENABLE_REGISTRATION=true
ENABLE_OAUTH=true
ENABLE_2FA=true
ENABLE_ANALYTICS=true
ENABLE_ML_FEATURES=false

# ========================================
# Rate Limiting
# ========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ========================================
# CORS Configuration
# ========================================
CORS_ORIGIN=https://yourdomain.com
CORS_CREDENTIALS=true

# ========================================
# Session Configuration
# ========================================
SESSION_MAX_AGE=86400000
SESSION_SECURE=true
SESSION_SAME_SITE=lax

# ========================================
# Logging
# ========================================
LOG_LEVEL=info
LOG_FORMAT=json

# ========================================
# Misc
# ========================================
TIMEZONE=America/New_York
MAX_FILE_SIZE=10485760
