modules = ["nodejs-20", "web", "postgresql-16", "python-3.11"]
run = "pnpm dev:replit"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist", "apps/**/dist", "packages/**/dist", "backend"]

[nix]
channel = "stable-24_05"
packages = ["glibcLocales", "libxcrypt"]

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", "./start-prod-safe.sh"]

[[ports]]
localPort = 80
externalPort = 80

[env]
PORT = "80"
CHOKIDAR_USEPOLLING = "1"
WATCHPACK_POLLING = "true"
NODE_ENV = "development"
SERVE_STATIC = "true"
PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING = "1"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm dev:replit"
waitForPort = 80

[agent]
integrations = ["javascript_google_analytics==1.0.0", "javascript_sendgrid==1.0.0", "javascript_database==1.0.0", "javascript_stripe==1.0.0", "javascript_log_in_with_replit==1.0.0", "perplexity_v0==1.0.0", "javascript_openai==1.0.0", "javascript_websocket==1.0.0"]
