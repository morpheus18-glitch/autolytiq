# syntax=docker/dockerfile:1.7
# Consolidated Dockerfile for ALL Rust microservices
# Builds all services in one image, dispatcher selects which to run

ARG RUST_VERSION=1.81

# ---------- Builder ----------
FROM rust:${RUST_VERSION}-slim-bookworm AS builder

# Install build dependencies for tonic/openssl/protobuf
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    libpq-dev \
    clang \
    protobuf-compiler \
    cmake \
    make \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy workspace manifests FIRST (for dependency caching)
COPY services/rust/Cargo.toml services/rust/Cargo.toml

# Copy all member Cargo.toml files
COPY services/rust/price-engine/Cargo.toml services/rust/price-engine/Cargo.toml
COPY services/rust/shared/Cargo.toml services/rust/shared/Cargo.toml
COPY services/rust/cache-service/Cargo.toml services/rust/cache-service/Cargo.toml
COPY services/rust/comm-service/Cargo.toml services/rust/comm-service/Cargo.toml
COPY services/rust/rate-limiter/Cargo.toml services/rust/rate-limiter/Cargo.toml
COPY services/rust/tax-svc/Cargo.toml services/rust/tax-svc/Cargo.toml

# Create dummy src files to cache dependency builds
RUN mkdir -p services/rust/price-engine/src \
             services/rust/shared/src \
             services/rust/cache-service/src \
             services/rust/comm-service/src \
             services/rust/rate-limiter/src \
             services/rust/tax-svc/src && \
    echo 'fn main() {}' > services/rust/price-engine/src/main.rs && \
    echo 'fn main() {}' > services/rust/cache-service/src/main.rs && \
    echo 'fn main() {}' > services/rust/comm-service/src/main.rs && \
    echo 'fn main() {}' > services/rust/rate-limiter/src/main.rs && \
    echo 'fn main() {}' > services/rust/tax-svc/src/main.rs && \
    echo 'pub fn placeholder() {}' > services/rust/shared/src/lib.rs

# Fetch dependencies with correct workspace path
RUN cargo fetch --manifest-path services/rust/Cargo.toml

# Now copy all actual source code
COPY services/rust/ services/rust/

# Build ALL workspace binaries in release mode
RUN cargo build \
    --manifest-path services/rust/Cargo.toml \
    --workspace \
    --bins \
    --release \
    -j $(nproc)

# Collect binaries and verify they exist
RUN mkdir -p /tmp/binaries && \
    for bin in price-engine cache-service comm-service rate-limiter tax-svc; do \
      if [ -f "target/release/$bin" ]; then \
        echo "✓ Found binary: $bin"; \
        cp "target/release/$bin" "/tmp/binaries/$bin"; \
      else \
        echo "✗ ERROR: Binary not found: $bin"; \
        echo "Available binaries:"; \
        ls -lh target/release/ | grep -E '^-rwx'; \
        exit 1; \
      fi; \
    done && \
    echo "All binaries collected successfully:" && \
    ls -lh /tmp/binaries/

# ---------- Runtime ----------
FROM debian:12-slim AS runtime

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    libpq5 \
    curl \
 && rm -rf /var/lib/apt/lists/* && \
    groupadd --system --gid 1001 rustsvc && \
    useradd --system --uid 1001 --gid rustsvc --home /app --shell /usr/sbin/nologin rustsvc

WORKDIR /app

# Copy all service binaries
RUN mkdir -p /app/bin
COPY --from=builder /tmp/binaries/price-engine /app/bin/price-engine
COPY --from=builder /tmp/binaries/cache-service /app/bin/cache-service
COPY --from=builder /tmp/binaries/comm-service /app/bin/comm-service
COPY --from=builder /tmp/binaries/rate-limiter /app/bin/rate-limiter
COPY --from=builder /tmp/binaries/tax-svc /app/bin/tax-svc

# Copy dispatcher script
COPY services/rust/ops/dispatch.sh /app/dispatch.sh
RUN chmod +x /app/dispatch.sh /app/bin/*

# Create storage directory
RUN mkdir -p /app/storage && \
    chown -R rustsvc:rustsvc /app

USER rustsvc

# Expose all possible ports (actual port depends on SERVICE_NAME)
EXPOSE 50051 50052 50053 50054 8080

# Default to info logging
ENV RUST_LOG=info

# Verify binaries are executable
RUN ls -lh /app/bin/

ENTRYPOINT ["/app/dispatch.sh"]
