# syntax=docker/dockerfile:1.7

FROM node:20-bookworm-slim AS base
ENV PNPM_HOME="/pnpm" \
    PATH="$PNPM_HOME:$PATH"

RUN corepack enable \
 && apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

FROM base AS dependencies
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/frontend/package.json apps/frontend/
COPY packages/tokens/package.json packages/tokens/
RUN pnpm install --frozen-lockfile --filter @repo/frontend...

FROM dependencies AS builder
ARG VITE_API_URL=https://api.autolytiq.com
ARG VITE_ML_SERVICE_URL=https://ml.autolytiq.com
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_ML_SERVICE_URL=$VITE_ML_SERVICE_URL
COPY . .
RUN pnpm --filter @repo/tokens build
RUN pnpm --filter @repo/frontend build

FROM nginxinc/nginx-unprivileged:1.27.2-alpine AS runner
COPY infrastructure/docker/nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/frontend/dist /usr/share/nginx/html

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/health >/dev/null || exit 1

CMD ["/usr/sbin/nginx", "-g", "daemon off;"]
