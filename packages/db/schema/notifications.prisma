// Notifications System - Real-time user notifications

model Notification {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")

  // Content
  type      NotificationType
  title     String
  message   String   @db.Text
  link      String?  // Optional link to navigate to
  metadata  Json?    // Additional data

  // Status
  isRead    Boolean  @default(false) @map("is_read")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  readAt    DateTime? @map("read_at")

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, isRead])
  @@index([tenantId, userId, createdAt])
  @@map("notifications")
}

enum NotificationType {
  DEAL      // Deal status changes, approvals needed
  LEAD      // New lead assignments, lead updates
  MESSAGE   // New messages, mentions
  TASK      // Task assignments, due dates
  SYSTEM    // System notifications, maintenance

  @@map("notification_type")
}
