// Notes System - Context-Aware Note Taking
// Supports notes attached to any entity (customers, appraisals, deals, vehicles, etc.)

model Note {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")

  // Content
  content   String   @db.Text

  // Context - determines where the note appears
  context   NoteContext

  // Entity this note belongs to
  entityId    String    @map("entity_id")
  entityType  String?   @map("entity_type") // For standalone context

  // Metadata
  isPrivate   Boolean   @default(false) @map("is_private")
  tags        String[]  @default([])

  // Relationships (optional - for querying)
  customerId   String?   @map("customer_id")
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  appraisalId  String?   @map("appraisal_id")
  appraisal    Appraisal? @relation(fields: [appraisalId], references: [id], onDelete: Cascade)

  dealId       String?   @map("deal_id")
  deal         Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  vehicleId    String?   @map("vehicle_id")
  vehicle      Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  leadId       String?   @map("lead_id")
  lead         Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  serviceOrderId String?  @map("service_order_id")
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  // Author
  createdBy     String    @map("created_by")
  createdByName String?   @map("created_by_name")
  user          User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, context, entityId])
  @@index([tenantId, customerId])
  @@index([tenantId, appraisalId])
  @@index([tenantId, dealId])
  @@index([tenantId, vehicleId])
  @@index([tenantId, leadId])
  @@index([tenantId, createdBy])
  @@index([createdAt])
  @@map("notes")
}

enum NoteContext {
  CUSTOMER    // Appears in customer timeline
  SHOWROOM    // Appears in customer timeline (from showroom manager)
  APPRAISAL   // Stays with appraisal record
  DEAL        // Appears in deal history
  VEHICLE     // Stays with vehicle record
  LEAD        // Appears in lead timeline
  SERVICE     // Stays with service order
  STANDALONE  // Generic note, use entityType to specify

  @@map("note_context")
}
