generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantPlan {
  TRIAL
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum UserRole {
  ADMIN
  MANAGER
  SALES
  SALES_MANAGER
  FINANCE
  FI_MANAGER
  SERVICE
  BDC
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum PreferredContactMethod {
  EMAIL
  PHONE
  SMS
}

enum LeadSource {
  WEBSITE
  REFERRAL
  WALKIN
  WALK_IN
  PHONE
  EMAIL
  SOCIAL_MEDIA
  THIRD_PARTY
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  SCHEDULED
  NEGOTIATION
  WON
  HOT
  WARM
  COLD
  LOST
  CUSTOMER
  ARCHIVED
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  SMS
  TASK
  MEETING
  VISIT
  TEST_DRIVE
  FOLLOW_UP
}

enum ActivityStatus {
  PENDING
  COMPLETED
  CANCELED
  SKIPPED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum AppointmentType {
  TEST_DRIVE
  DELIVERY
  FINANCE
  SERVICE
  OTHER
}

enum CommunicationType {
  CALL
  SMS
  EMAIL
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
}

enum CommunicationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

enum InteractionType {
  CALL
  EMAIL
  SMS
  VISIT
  TEST_DRIVE
  FOLLOW_UP
}

enum InteractionDirection {
  INBOUND
  OUTBOUND
}

enum CustomerVehicleStatus {
  OWNED
  TRADED
  SOLD
}

enum VehicleType {
  NEW
  USED
  CERTIFIED
}

enum FuelType {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
}

enum VehicleStatus {
  AVAILABLE
  PENDING
  SOLD
  IN_TRANSIT
  SERVICE
  WHOLESALE
}

enum VehicleHistoryType {
  SERVICE
  ACCIDENT
  OWNERSHIP
  INSPECTION
}

enum VehicleAcquisitionType {
  TRADE_IN
  AUCTION
  PURCHASE
  FLOOR_PLAN
  CONSIGNMENT
  OTHER
}

enum AppraisalStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
}

enum AppraisalConditionGrade {
  ROUGH
  AVERAGE
  CLEAN
  EXCELLENT
}

enum ReconItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum PriceChangeType {
  MANUAL
  MARKET
  AI_RECOMMENDATION
  FLOOR_PLAN
}

enum AuctionPurchaseStatus {
  PENDING
  WON
  LOST
  CANCELLED
}

enum WholesaleListingStatus {
  DRAFT
  LISTED
  UNDER_CONTRACT
  SOLD
  WITHDRAWN
}

enum MarketCompSource {
  RETAIL_LISTING
  WHOLESALE_LISTING
  AUCTION_RESULT
  THIRD_PARTY
  INTERNAL
}

enum DealType {
  CASH
  FINANCE
  LEASE
}

enum RetailDealStatus {
  DRAFT
  PENDING
  SUBMITTED
  APPROVED
  FUNDED
  DELIVERED
  CANCELLED
}

enum DealStatus {
  WORKING
  PENCILED
  SUBMITTED
  CLOSED
  LOST
}

enum CreditTier {
  TIER_1
  TIER_2
  TIER_3
  TIER_4
  TIER_5
  TIER_6
}

enum ResidenceType {
  OWN
  RENT
  LEASE
  FAMILY
  MILITARY
  OTHER
}

enum Recommendation {
  STRONG
  MODERATE
  WEAK
  DO_NOT_SUBMIT
}

enum CounterOfferOutcome {
  PENDING
  ACCEPTED
  DECLINED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum JournalStatus {
  DRAFT
  POSTED
  VOID
}

enum LineType {
  DEBIT
  CREDIT
}

enum CommissionType {
  FRONT
  BACK
  BONUS
  SPIFF
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CHARGEBACK
}

enum ReportType {
  SALES
  INVENTORY
  FINANCE
  CUSTOM
}

enum NotificationType {
  DEAL_APPROVAL
  FOLLOW_UP
  INVENTORY_ALERT
  TASK
  SYSTEM
}

enum WorkflowTaskType {
  DETAIL
  PHOTOS
  RECON
  TRANSPORT
  PRICING
  LISTING
  QA
  OTHER
}

enum WorkflowTaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TransportOrderStatus {
  REQUESTED
  SCHEDULED
  PICKED_UP
  DELIVERED
  CANCELLED
}

enum AutomationExecutionStatus {
  SUCCESS
  FAILED
  SKIPPED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW
}

model Tenant {
  id                 String       @id @default(cuid())
  name               String
  subdomain          String       @unique
  plan               TenantPlan   @default(BASIC)
  status             TenantStatus @default(ACTIVE)
  settings           Json         @default(dbgenerated("'{}'::jsonb"))
  billingEmail       String
  subscriptionEndsAt DateTime?    @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(6)

  users                User[]
  customers            Customer[]
  customerInteractions CustomerInteraction[]
  customerVehicles     CustomerVehicle[]
  leads                Lead[]
  activities           Activity[]
  appointments         Appointment[]
  leadScores           LeadScore[]
  communications       Communication[]
  emailTemplates       EmailTemplate[]
  smsTemplates         SMSTemplate[]
  automations          Automation[]
  automationExecutions AutomationExecution[]
  vehicles             Vehicle[]
  vehicleHistories     VehicleHistory[]
  appraisals           Appraisal[]
  reconItems           ReconItem[]
  priceHistories       PriceHistory[]
  auctionPurchases     AuctionPurchase[]
  wholesaleListings    WholesaleListing[]
  marketComps          MarketComp[]
  deals                Deal[]
  dealWorksheets       DealWorksheet[]
  dealVersions         DealVersion[]
  dealOptimizations    DealOptimization[]
  counterOffers        CounterOffer[]
  approvalPredictions  ApprovalPrediction[]
  dealJackets          DealJacket[]
  creditApplications   CreditApplication[]
  creditReports        CreditReport[]
  creditSubmissions    CreditSubmissionDraft[]
  lenders              Lender[]
  lenderSubmissions    LenderSubmission[]
  contracts            Contract[]
  fundingChecklists    FundingChecklist[]
  complianceChecklists ComplianceChecklist[]
  glAccounts           GLAccount[]
  journalEntries       JournalEntry[]
  journalEntryLines    JournalEntryLine[]
  commissions          Commission[]
  reports              Report[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  systemSettings       SystemSetting[]
  fiProducts           FIProduct[]
  menuConfigurations   MenuConfiguration[]
  workflowDefinitions  WorkflowDefinition[]
  workflowStages       WorkflowStage[]
  vehicleWorkflows     VehicleWorkflow[]
  workflowTasks        WorkflowTask[]
  stageTransitions     StageTransition[]
  transportOrders      TransportOrder[]
  pipelineAggregates   PipelineAggregate[]
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  email        String
  password     String
  firstName    String
  lastName     String
  phone        String?
  role         UserRole   @default(SALES)
  permissions  Json       @default(dbgenerated("jsonb_build_array()"))
  status       UserStatus @default(ACTIVE)
  isSuperAdmin Boolean    @default(false)
  lastLoginAt  DateTime?  @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime?  @db.Timestamptz(6)

  tenant                    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customers                 Customer[]            @relation("CustomerAssignedTo")
  interactions              CustomerInteraction[]
  leadsAssigned             Lead[]                @relation("LeadAssignedTo")
  leadsOwned                Lead[]                @relation("LeadOwner")
  activities                Activity[]
  appointments              Appointment[]         @relation("AppointmentAssignedTo")
  communications            Communication[]
  dealsAsSales              Deal[]                @relation("SalesPersonDeals")
  dealsAsFinance            Deal[]                @relation("FinanceManagerDeals")
  dealJacketsAsSales        DealJacket[]          @relation("DealJacketSalesperson")
  dealJacketsAsFinance      DealJacket[]          @relation("DealJacketFIManager")
  fundingChecklistsReviewed FundingChecklist[]    @relation("FundingChecklistReviewer")
  journalEntries            JournalEntry[]
  commissions               Commission[]
  reports                   Report[]              @relation("ReportCreatedBy")
  notifications             Notification[]
  auditLogs                 AuditLog[]
  systemSettings            SystemSetting[]
  appraisalsCreated         Appraisal[]           @relation("AppraisalsAppraiser")
  appraisalsReviewed        Appraisal[]           @relation("AppraisalsManager")
  priceChanges              PriceHistory[]        @relation("PriceHistoryChangedBy")
  assignedWorkflowTasks     WorkflowTask[]        @relation("WorkflowTaskAssignee")
  stageTransitions          StageTransition[]     @relation("StageTransitionActor")
  dealWorksheets            DealWorksheet[]       @relation("DealWorksheetSalesperson")
  dealVersionsCreated       DealVersion[]         @relation("DealVersionCreatedBy")
  dealOptimizationsRun      DealOptimization[]    @relation("DealOptimizationRunBy")
  counterOffersHandled      CounterOffer[]        @relation("CounterOfferHandledBy")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([isSuperAdmin])
}

model Customer {
  id                     String                   @id @default(cuid())
  tenantId               String
  firstName              String
  lastName               String
  email                  String?
  phone                  String?
  mobile                 String?
  dateOfBirth            DateTime?                @db.Date
  driversLicenseNumber   String?
  driversLicenseState    String?
  ssn                    String?
  addressStreet          String?
  addressCity            String?
  addressState           String?
  addressZip             String?
  addressCountry         String?
  preferredContactMethod PreferredContactMethod   @default(EMAIL)
  leadSource             LeadSource               @default(WEBSITE)
  leadStatus             LeadStatus               @default(NEW)
  leadScore              Int                      @default(0)
  creditScore            Int?
  assignedToUserId       String?
  tags                   String[]                 @default([])
  notes                  String?
  lifetimeValue          Decimal                  @default(0) @db.Decimal(18, 2)
  createdAt              DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                 @updatedAt @db.Timestamptz(6)
  deletedAt              DateTime?                @db.Timestamptz(6)
  searchVector           Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english', coalesce(\"firstName\",'') || ' ' || coalesce(\"lastName\",'') || ' ' || coalesce(\"email\",'') || ' ' || coalesce(\"phone\",''))")) @map("search_vector")

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedToUser User?                 @relation("CustomerAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  interactions   CustomerInteraction[]
  leads          Lead[]
  activities     Activity[]
  appointments   Appointment[]
  communications Communication[]
  vehicles       CustomerVehicle[]
  deals          Deal[]
  dealWorksheets DealWorksheet[]
  dealJackets    DealJacket[]

  @@index([tenantId, leadStatus])
  @@index([tenantId, assignedToUserId])
  @@index([searchVector], type: Gin)
  @@index([tenantId, lastName, firstName])
}

model CustomerInteraction {
  id          String               @id @default(cuid())
  tenantId    String
  customerId  String
  userId      String
  type        InteractionType
  direction   InteractionDirection
  subject     String?
  notes       String?
  duration    Int?
  scheduledAt DateTime?            @db.Timestamptz(6)
  completedAt DateTime?            @db.Timestamptz(6)
  createdAt   DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime?            @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@index([tenantId, scheduledAt])
}

model Lead {
  id                  String       @id @default(cuid())
  tenantId            String
  customerId          String?
  assignedToId        String?
  ownerId             String?
  firstName           String?
  lastName            String?
  email               String?
  phone               String?
  status              LeadStatus   @default(NEW)
  source              LeadSource   @default(WEBSITE)
  priority            LeadPriority @default(MEDIUM)
  rating              Int?
  score               Int?
  smsOptOut           Boolean      @default(false)
  emailOptOut         Boolean      @default(false)
  callOptOut          Boolean      @default(false)
  isArchived          Boolean      @default(false)
  isConverted         Boolean      @default(false)
  lastActivityAt      DateTime?    @db.Timestamptz(6)
  lastCommunicationAt DateTime?    @db.Timestamptz(6)
  nextActionAt        DateTime?    @db.Timestamptz(6)
  convertedAt         DateTime?    @db.Timestamptz(6)
  description         String?
  tags                String[]     @default([])
  createdAt           DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo     User?           @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  owner          User?           @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities     Activity[]
  appointments   Appointment[]
  communications Communication[]
  scores         LeadScore[]

  @@index([tenantId, status])
  @@index([tenantId, assignedToId])
  @@index([tenantId, ownerId])
  @@index([tenantId, source])
  @@index([tenantId, isArchived, status])
  @@index([tenantId, createdAt])
}

model Activity {
  id          String         @id @default(cuid())
  tenantId    String
  leadId      String?
  customerId  String?
  userId      String?
  type        ActivityType
  status      ActivityStatus @default(PENDING)
  subject     String?
  description String?
  outcome     String?
  metadata    Json?
  opened      Boolean        @default(false)
  clicked     Boolean        @default(false)
  dueAt       DateTime?      @db.Timestamptz(6)
  startedAt   DateTime?      @db.Timestamptz(6)
  completedAt DateTime?      @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(6)

  tenant                 Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead                   Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer               Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user                   User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  communications         Communication[]
  followUpForAppointment Appointment?    @relation("AppointmentFollowUpTask")

  @@index([tenantId, leadId])
  @@index([tenantId, userId])
  @@index([tenantId, dueAt])
  @@index([tenantId, status])
}

model Appointment {
  id             String            @id @default(cuid())
  tenantId       String
  leadId         String?
  customerId     String?
  assignedToId   String?
  vehicleId      String?
  title          String
  notes          String?
  type           AppointmentType
  status         AppointmentStatus @default(SCHEDULED)
  location       String?
  timeZone       String?           @default("UTC")
  startAt        DateTime          @db.Timestamptz(6)
  endAt          DateTime?         @db.Timestamptz(6)
  checkedInAt    DateTime?         @db.Timestamptz(6)
  completedAt    DateTime?         @db.Timestamptz(6)
  cancelledAt    DateTime?         @db.Timestamptz(6)
  noShowAt       DateTime?         @db.Timestamptz(6)
  outcome        String?
  followUpTaskId String?           @unique
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead         Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo   User?     @relation("AppointmentAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  vehicle      Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  followUpTask Activity? @relation("AppointmentFollowUpTask", fields: [followUpTaskId], references: [id], onDelete: SetNull)

  @@index([tenantId, startAt])
  @@index([tenantId, status])
  @@index([tenantId, leadId])
  @@index([tenantId, assignedToId])
  @@index([tenantId, vehicleId])
}

model LeadScore {
  id         String   @id @default(cuid())
  tenantId   String
  leadId     String
  modelKey   String
  score      Int
  scoreDelta Int?
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId])
  @@index([tenantId, createdAt])
}

model Communication {
  id         String                 @id @default(cuid())
  tenantId   String
  type       CommunicationType
  direction  CommunicationDirection
  to         String
  from       String
  subject    String?
  body       String?
  providerId String?
  status     CommunicationStatus?
  metadata   Json?
  leadId     String?
  customerId String?
  activityId String?
  userId     String?
  createdAt  DateTime               @default(now()) @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, type])
  @@index([tenantId, leadId])
  @@index([tenantId, createdAt])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  subject   String
  html      String
  text      String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, updatedAt])
}

model SMSTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  body      String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, updatedAt])
}

model Automation {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  trigger   Json
  actions   Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  executions AutomationExecution[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model AutomationExecution {
  id           String                    @id @default(cuid())
  tenantId     String
  automationId String?
  triggerType  String
  status       AutomationExecutionStatus @default(SUCCESS)
  context      Json?
  result       Json?
  error        String?
  startedAt    DateTime                  @default(now()) @db.Timestamptz(6)
  completedAt  DateTime?                 @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  automation Automation? @relation(fields: [automationId], references: [id], onDelete: SetNull)

  @@index([tenantId, triggerType])
  @@index([tenantId, automationId])
}

model CustomerVehicle {
  id             String                @id @default(cuid())
  tenantId       String
  customerId     String
  vin            String
  year           Int
  make           String
  model          String
  trim           String?
  purchaseDate   DateTime?             @db.Timestamptz(6)
  purchasePrice  Decimal?              @db.Decimal(18, 2)
  currentMileage Int?
  status         CustomerVehicleStatus @default(OWNED)
  tradedInDate   DateTime?             @db.Timestamptz(6)
  notes          String?
  createdAt      DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(6)

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tradeDeals Deal[]   @relation("TradeVehicleDeal")

  @@unique([tenantId, vin])
  @@index([tenantId, customerId])
}

model Vehicle {
  id                    String                   @id @default(cuid())
  tenantId              String
  stockNumber           String
  vin                   String
  type                  VehicleType
  year                  Int
  make                  String
  model                 String
  trim                  String?
  exteriorColor         String?
  interiorColor         String?
  mileage               Int?
  engineType            String?
  transmission          String?
  drivetrain            String?
  fuelType              FuelType
  msrp                  Decimal?                 @db.Decimal(18, 2)
  invoiceCost           Decimal?                 @db.Decimal(18, 2)
  listPrice             Decimal?                 @db.Decimal(18, 2)
  specialPrice          Decimal?                 @db.Decimal(18, 2)
  status                VehicleStatus            @default(AVAILABLE)
  location              String?
  dateReceived          DateTime?                @db.Timestamptz(6)
  dateSold              DateTime?                @db.Timestamptz(6)
  daysInStock           Int?                     @default(0)
  images                String[]                 @default([])
  features              String[]                 @default([])
  certificationNumber   String?
  floorPlanId           String?
  floorPlanDate         DateTime?                @db.Timestamptz(6)
  floorPlanInterestRate Decimal?                 @db.Decimal(5, 2)
  acquisitionType       VehicleAcquisitionType?
  acquisitionSource     String?
  acquisitionDate       DateTime?                @db.Timestamptz(6)
  acquisitionCost       Decimal?                 @db.Decimal(18, 2)
  floorPrice            Decimal?                 @db.Decimal(18, 2)
  wholesaleValue        Decimal?                 @db.Decimal(18, 2)
  marketValue           Decimal?                 @db.Decimal(18, 2)
  targetPrice           Decimal?                 @db.Decimal(18, 2)
  aiPrice               Decimal?                 @db.Decimal(18, 2)
  pricingNotes          String?
  appraisalStatus       AppraisalStatus?
  lastAppraisedAt       DateTime?                @db.Timestamptz(6)
  reconEstimate         Decimal?                 @db.Decimal(18, 2)
  reconActual           Decimal?                 @db.Decimal(18, 2)
  reconCompletedAt      DateTime?                @db.Timestamptz(6)
  agingBucket           String?
  nextPriceReviewDate   DateTime?                @db.Timestamptz(6)
  notes                 String?
  createdAt             DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                 @updatedAt @db.Timestamptz(6)
  deletedAt             DateTime?                @db.Timestamptz(6)
