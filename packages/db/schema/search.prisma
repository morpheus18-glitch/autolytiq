// Search System - Query logging and analytics

model SearchQuery {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  userId        String   @map("user_id")

  // Query details
  query         String   // Original query text
  parsedQuery   Json?    @map("parsed_query") // Parsed NLP structure
  resultType    String   @map("result_type") // customers, vehicles, deals, etc.
  resultCount   Int      @map("result_count")
  executionTime Int      @map("execution_time") // milliseconds

  // Analytics
  clicked       Boolean  @default(false) // Did user click a result?

  // Timestamps
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, createdAt])
  @@index([tenantId, resultType])
  @@map("search_queries")
}

// Popular searches cache
model PopularSearch {
  id        String   @id @default(cuid())
  tenantId  String?  @map("tenant_id") // null = global
  query     String   @unique
  category  String   // customer, vehicle, deal, report
  count     Int      @default(1)
  lastUsed  DateTime @default(now()) @map("last_used") @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, category])
  @@index([count])
  @@map("popular_searches")
}
