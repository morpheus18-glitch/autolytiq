# --- build ---
FROM node:18-bullseye-slim AS build
WORKDIR /app
COPY apps/backend/package*.json ./
RUN npm ci
COPY apps/backend/ ./
RUN npm run build  # tsup → dist/

# --- runtime ---
FROM node:18-bullseye-slim
ENV NODE_ENV=production
WORKDIR /app
COPY apps/backend/package*.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist ./dist
EXPOSE 5000
CMD ["node","dist/server.js"]
