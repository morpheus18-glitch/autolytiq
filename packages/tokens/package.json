{
  "name": "@repo/tokens",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "tokens:build": "tsx scripts/build-tokens.ts",
    "build": "npm run tokens:build && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "tsup": "^8.1.0",
    "tsx": "^4.7.0",
    "typescript": "5.6.3"
  }
}
