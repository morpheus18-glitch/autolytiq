{
  "name": "@repo/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "build": "tsup && node scripts/postbuild.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'Backend linting skipped (intentionally ignored in root .eslintrc.cjs)'",
    "test": "vitest run --passWithNoTests",
    "verify:deal-integrity": "tsx src/scripts/verify-deal-integrity.ts",
    "benchmark": "tsx src/scripts/benchmark-performance.ts",
    "ml:cache:cleanup": "tsx -e \"import { cleanupExpiredCache } from './src/services/ml-cache.service.js'; await cleanupExpiredCache(); process.exit(0);\""
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.9.14",
    "@grpc/proto-loader": "^0.7.10",
    "@prisma/client": "5.22.0",
    "axios": "^1.7.9",
    "bullmq": "^5.32.2",
    "chokidar": "^4.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.15.0",
    "socket.io": "^4.8.1",
    "twilio": "^5.3.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "20.16.11",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.13.5",
    "nodemon": "^3.1.10",
    "prisma": "5.22.0",
    "tsup": "^8.1.0",
    "tsx": "^4.19.1",
    "typescript": "5.6.3",
    "vitest": "^2.1.4"
  }
}
