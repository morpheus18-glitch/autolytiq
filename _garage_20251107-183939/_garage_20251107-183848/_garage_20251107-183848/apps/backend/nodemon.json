{
  "watch": ["src", "../../packages/shared/dist"],
  "ext": "ts,js,json",
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.git/**",
    "**/apps/frontend/**",
    "**/migrations/**",
    "**/*.test.ts",
    "**/*.spec.ts"
  ],
  "exec": "tsx src/index.ts",
  "delay": 300,
  "legacyWatch": true
}
