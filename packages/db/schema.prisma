generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                   String                  @id @default(cuid())
  name                 String
  subdomain            String                  @unique
  plan                 TenantPlan              @default(BASIC)
  status               TenantStatus            @default(ACTIVE)
  settings             Json                    @default("{}")
  billingEmail         String                  @map("billing_email")
  subscriptionEndsAt   DateTime?               @map("subscription_ends_at") @db.Timestamptz(6)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  activities           Activity[]
  appointments         Appointment[]
  appraisals           Appraisal[]
  approvalPredictions  ApprovalPrediction[]
  auctionPurchases     AuctionPurchase[]
  auditLogs            AuditLog[]
  automationExecutions AutomationExecution[]
  automations          Automation[]
  commissions          Commission[]
  communications       Communication[]
  complianceChecklists ComplianceChecklist[]
  contracts            Contract[]
  counterOffers        CounterOffer[]
  creditApplications   CreditApplication[]
  creditReports        CreditReport[]
  creditSubmissions    CreditSubmissionDraft[]
  customerInteractions CustomerInteraction[]
  customerVehicles     CustomerVehicle[]
  customers            Customer[]
  dealJackets          DealJacket[]
  dealOptimizations    DealOptimization[]
  dealVersions         DealVersion[]
  dealWorksheets       DealWorksheet[]
  deals                Deal[]
  emailTemplates       EmailTemplate[]
  fiProducts           FIProduct[]
  fundingChecklists    FundingChecklist[]
  glAccounts           GLAccount[]
  journalEntries       JournalEntry[]
  journalEntryLines    JournalEntryLine[]
  leadScores           LeadScore[]
  leads                Lead[]
  lenderSubmissions    LenderSubmission[]
  lenders              Lender[]
  marketComps          MarketComp[]
  menuConfigurations   MenuConfiguration[]
  notifications        Notification[]
  pipelineAggregates   PipelineAggregate[]
  priceHistories       PriceHistory[]
  reconItems           ReconItem[]
  reports              Report[]
  smsTemplates         SMSTemplate[]
  stageTransitions     StageTransition[]
  systemSettings       SystemSetting[]
  transportOrders      TransportOrder[]
  users                User[]
  vehicleHistories     VehicleHistory[]
  vehicleWorkflows     VehicleWorkflow[]
  vehicles             Vehicle[]
  wholesaleListings    WholesaleListing[]
  workflowDefinitions  WorkflowDefinition[]
  workflowStages       WorkflowStage[]
  workflowTasks        WorkflowTask[]
  outboxEvents         Outbox[]
  dealEvents           DealEvent[]
  mlFeatureCaches      MLFeatureCache[]

  @@map("tenants")
}

model User {
  id                        String                @id @default(cuid())
  tenantId                  String                @map("tenant_id")
  email                     String
  password                  String
  firstName                 String                @map("first_name")
  lastName                  String                @map("last_name")
  phone                     String?
  role                      UserRole              @default(SALES)
  permissions               Json                  @default(dbgenerated("jsonb_build_array()"))
  status                    UserStatus            @default(ACTIVE)
  isSuperAdmin              Boolean               @default(false) @map("is_super_admin")
  lastLoginAt               DateTime?             @map("last_login_at") @db.Timestamptz(6)
  createdAt                 DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                 DateTime?             @map("deleted_at") @db.Timestamptz(6)
  activities                Activity[]
  appointments              Appointment[]         @relation("AppointmentAssignedTo")
  appraisalsCreated         Appraisal[]           @relation("AppraisalsAppraiser")
  appraisalsReviewed        Appraisal[]           @relation("AppraisalsManager")
  auditLogs                 AuditLog[]
  commissions               Commission[]
  communications            Communication[]
  counterOffersHandled      CounterOffer[]        @relation("CounterOfferHandledBy")
  interactions              CustomerInteraction[]
  customers                 Customer[]            @relation("CustomerAssignedTo")
  dealJacketsAsFinance      DealJacket[]          @relation("DealJacketFIManager")
  dealJacketsAsSales        DealJacket[]          @relation("DealJacketSalesperson")
  dealOptimizationsRun      DealOptimization[]    @relation("DealOptimizationRunBy")
  dealVersionsCreated       DealVersion[]         @relation("DealVersionCreatedBy")
  dealWorksheets            DealWorksheet[]       @relation("DealWorksheetSalesperson")
  dealsAsFinance            Deal[]                @relation("FinanceManagerDeals")
  dealsAsSales              Deal[]                @relation("SalesPersonDeals")
  fundingChecklistsReviewed FundingChecklist[]    @relation("FundingChecklistReviewer")
  journalEntries            JournalEntry[]
  leadsAssigned             Lead[]                @relation("LeadAssignedTo")
  leadsOwned                Lead[]                @relation("LeadOwner")
  notifications             Notification[]
  priceChanges              PriceHistory[]        @relation("PriceHistoryChangedBy")
  reports                   Report[]              @relation("ReportCreatedBy")
  stageTransitions          StageTransition[]     @relation("StageTransitionActor")
  systemSettings            SystemSetting[]
  tenant                    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedWorkflowTasks     WorkflowTask[]        @relation("WorkflowTaskAssignee")
  dealEventsCreated         DealEvent[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([isSuperAdmin])
  @@map("users")
}

model Customer {
  id                     String                 @id @default(cuid())
  tenantId               String                 @map("tenant_id")
  firstName              String                 @map("first_name")
  lastName               String                 @map("last_name")
  email                  String?
  phone                  String?
  mobile                 String?
  dateOfBirth            DateTime?              @map("date_of_birth") @db.Date
  driversLicenseNumber   String?                @map("drivers_license_number")
  driversLicenseState    String?                @map("drivers_license_state")
  ssn                    String?
  addressStreet          String?                @map("address_street")
  addressCity            String?                @map("address_city")
  addressState           String?                @map("address_state")
  addressZip             String?                @map("address_zip")
  addressCountry         String?                @map("address_country")
  preferredContactMethod PreferredContactMethod @default(EMAIL) @map("preferred_contact_method")
  leadSource             LeadSource             @default(WEBSITE) @map("lead_source")
  leadStatus             LeadStatus             @default(NEW) @map("lead_status")
  leadScore              Int                    @default(0) @map("lead_score")
  creditScore            Int?                   @map("credit_score")
  assignedToUserId       String?                @map("assigned_to_user_id")
  tags                   String[]               @default([])
  notes                  String?
  lifetimeValue          Decimal                @default(0) @map("lifetime_value") @db.Decimal(18, 2)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?              @map("deleted_at") @db.Timestamptz(6)
  searchVector           String?                @map("search_vector")
  activities             Activity[]
  appointments           Appointment[]
  communications         Communication[]
  interactions           CustomerInteraction[]
  vehicles               CustomerVehicle[]
  assignedToUser         User?                  @relation("CustomerAssignedTo", fields: [assignedToUserId], references: [id])
  tenant                 Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dealJackets            DealJacket[]
  dealWorksheets         DealWorksheet[]
  deals                  Deal[]
  leads                  Lead[]

  @@index([tenantId, leadStatus])
  @@index([tenantId, assignedToUserId])
  @@index([tenantId])
  @@index([tenantId, searchVector])
  @@index([tenantId, lastName, firstName])
  @@map("customers")
}

model CustomerInteraction {
  id          String               @id @default(cuid())
  tenantId    String               @map("tenant_id")
  customerId  String               @map("customer_id")
  userId      String               @map("user_id")
  type        InteractionType
  direction   InteractionDirection
  subject     String?
  notes       String?
  duration    Int?
  scheduledAt DateTime?            @map("scheduled_at") @db.Timestamptz(6)
  completedAt DateTime?            @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?            @map("deleted_at") @db.Timestamptz(6)
  customer    Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@index([tenantId, scheduledAt])
  @@map("customer_interactions")
}

model Lead {
  id                  String          @id @default(cuid())
  tenantId            String          @map("tenant_id")
  customerId          String?         @map("customer_id")
  assignedToId        String?         @map("assigned_to_id")
  ownerId             String?         @map("owner_id")
  firstName           String?         @map("first_name")
  lastName            String?         @map("last_name")
  email               String?
  phone               String?
  status              LeadStatus      @default(NEW)
  source              LeadSource      @default(WEBSITE)
  priority            LeadPriority    @default(MEDIUM)
  rating              Int?
  score               Int?
  smsOptOut           Boolean         @default(false) @map("sms_opt_out")
  emailOptOut         Boolean         @default(false) @map("email_opt_out")
  callOptOut          Boolean         @default(false) @map("call_opt_out")
  isArchived          Boolean         @default(false) @map("is_archived")
  isConverted         Boolean         @default(false) @map("is_converted")
  lastActivityAt      DateTime?       @map("last_activity_at") @db.Timestamptz(6)
  lastCommunicationAt DateTime?       @map("last_communication_at") @db.Timestamptz(6)
  nextActionAt        DateTime?       @map("next_action_at") @db.Timestamptz(6)
  convertedAt         DateTime?       @map("converted_at") @db.Timestamptz(6)
  description         String?
  tags                String[]        @default([])
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  activities          Activity[]
  appointments        Appointment[]
  communications      Communication[]
  scores              LeadScore[]
  assignedTo          User?           @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  customer            Customer?       @relation(fields: [customerId], references: [id])
  owner               User?           @relation("LeadOwner", fields: [ownerId], references: [id])
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, assignedToId])
  @@index([tenantId, ownerId])
  @@index([tenantId, source])
  @@index([tenantId, isArchived, status])
  @@index([tenantId, createdAt])
  @@map("leads")
}

model Activity {
  id                     String          @id @default(cuid())
  tenantId               String          @map("tenant_id")
  leadId                 String?         @map("lead_id")
  customerId             String?         @map("customer_id")
  userId                 String?         @map("user_id")
  type                   ActivityType
  status                 ActivityStatus  @default(PENDING)
  subject                String?
  description            String?
  outcome                String?
  metadata               Json?
  opened                 Boolean         @default(false)
  clicked                Boolean         @default(false)
  dueAt                  DateTime?       @map("due_at") @db.Timestamptz(6)
  startedAt              DateTime?       @map("started_at") @db.Timestamptz(6)
  completedAt            DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer               Customer?       @relation(fields: [customerId], references: [id])
  lead                   Lead?           @relation(fields: [leadId], references: [id])
  tenant                 Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                   User?           @relation(fields: [userId], references: [id])
  followUpForAppointment Appointment?    @relation("AppointmentFollowUpTask")
  communications         Communication[]

  @@index([tenantId, leadId])
  @@index([tenantId, userId])
  @@index([tenantId, dueAt])
  @@index([tenantId, status])
  @@map("activities")
}

model Appointment {
  id             String            @id @default(cuid())
  tenantId       String            @map("tenant_id")
  leadId         String?           @map("lead_id")
  customerId     String?           @map("customer_id")
  assignedToId   String?           @map("assigned_to_id")
  vehicleId      String?           @map("vehicle_id")
  title          String
  notes          String?
  type           AppointmentType
  status         AppointmentStatus @default(SCHEDULED)
  location       String?
  timeZone       String?           @default("UTC") @map("time_zone")
  startAt        DateTime          @map("start_at") @db.Timestamptz(6)
  endAt          DateTime?         @map("end_at") @db.Timestamptz(6)
  checkedInAt    DateTime?         @map("checked_in_at") @db.Timestamptz(6)
  completedAt    DateTime?         @map("completed_at") @db.Timestamptz(6)
  cancelledAt    DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  noShowAt       DateTime?         @map("no_show_at") @db.Timestamptz(6)
  outcome        String?
  followUpTaskId String?           @unique @map("follow_up_task_id")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignedTo     User?             @relation("AppointmentAssignedTo", fields: [assignedToId], references: [id])
  customer       Customer?         @relation(fields: [customerId], references: [id])
  followUpTask   Activity?         @relation("AppointmentFollowUpTask", fields: [followUpTaskId], references: [id])
  lead           Lead?             @relation(fields: [leadId], references: [id])
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle        Vehicle?          @relation(fields: [vehicleId], references: [id])

  @@index([tenantId, startAt])
  @@index([tenantId, status])
  @@index([tenantId, leadId])
  @@index([tenantId, assignedToId])
  @@index([tenantId, vehicleId])
  @@map("appointments")
}

model LeadScore {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  leadId     String   @map("lead_id")
  modelKey   String   @map("model_key")
  score      Int
  scoreDelta Int?     @map("score_delta")
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId])
  @@index([tenantId, createdAt])
  @@map("lead_scores")
}

model Communication {
  id         String                 @id @default(cuid())
  tenantId   String                 @map("tenant_id")
  type       CommunicationType
  direction  CommunicationDirection
  to         String
  from       String
  subject    String?
  body       String?
  providerId String?                @map("provider_id")
  status     CommunicationStatus?
  metadata   Json?
  leadId     String?                @map("lead_id")
  customerId String?                @map("customer_id")
  activityId String?                @map("activity_id")
  userId     String?                @map("user_id")
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  activity   Activity?              @relation(fields: [activityId], references: [id])
  customer   Customer?              @relation(fields: [customerId], references: [id])
  lead       Lead?                  @relation(fields: [leadId], references: [id])
  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?                  @relation(fields: [userId], references: [id])

  @@index([tenantId, type])
  @@index([tenantId, leadId])
  @@index([tenantId, createdAt])
  @@map("communications")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  subject   String
  html      String
  text      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, updatedAt])
  @@map("email_templates")
}

model SMSTemplate {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, updatedAt])
  @@map("sms_templates")
}

model Automation {
  id         String                @id @default(cuid())
  tenantId   String                @map("tenant_id")
  name       String
  trigger    Json
  actions    Json
  isActive   Boolean               @default(true) @map("is_active")
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  executions AutomationExecution[]
  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("automations")
}

model AutomationExecution {
  id           String                    @id @default(cuid())
  tenantId     String                    @map("tenant_id")
  automationId String?                   @map("automation_id")
  triggerType  String                    @map("trigger_type")
  status       AutomationExecutionStatus @default(SUCCESS)
  context      Json?
  result       Json?
  error        String?
  startedAt    DateTime                  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime?                 @map("completed_at") @db.Timestamptz(6)
  automation   Automation?               @relation(fields: [automationId], references: [id])
  tenant       Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, triggerType])
  @@index([tenantId, automationId])
  @@map("automation_executions")
}

model CustomerVehicle {
  id             String                @id @default(cuid())
  tenantId       String                @map("tenant_id")
  customerId     String                @map("customer_id")
  vin            String
  year           Int
  make           String
  model          String
  trim           String?
  purchaseDate   DateTime?             @map("purchase_date") @db.Timestamptz(6)
  purchasePrice  Decimal?              @map("purchase_price") @db.Decimal(18, 2)
  currentMileage Int?                  @map("current_mileage")
  status         CustomerVehicleStatus @default(OWNED)
  tradedInDate   DateTime?             @map("traded_in_date") @db.Timestamptz(6)
  notes          String?
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer       Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tradeDeals     Deal[]                @relation("TradeVehicleDeal")

  @@unique([tenantId, vin])
  @@index([tenantId, customerId])
  @@map("customer_vehicles")
}

model Vehicle {
  id                    String                  @id @default(cuid())
  tenantId              String                  @map("tenant_id")
  stockNumber           String                  @map("stock_number")
  vin                   String                  @unique
  type                  VehicleType
  year                  Int
  make                  String
  model                 String
  trim                  String?
  exteriorColor         String?                 @map("exterior_color")
  interiorColor         String?                 @map("interior_color")
  mileage               Int?
  engineType            String?                 @map("engine_type")
  transmission          String?
  drivetrain            String?
  fuelType              FuelType                @map("fuel_type")
  msrp                  Decimal?                @db.Decimal(18, 2)
  invoiceCost           Decimal?                @map("invoice_cost") @db.Decimal(18, 2)
  listPrice             Decimal?                @map("list_price") @db.Decimal(18, 2)
  specialPrice          Decimal?                @map("special_price") @db.Decimal(18, 2)
  status                VehicleStatus           @default(AVAILABLE)
  location              String?
  dateReceived          DateTime?               @map("date_received") @db.Timestamptz(6)
  dateSold              DateTime?               @map("date_sold") @db.Timestamptz(6)
  daysInStock           Int?                    @default(0) @map("days_in_stock")
  images                String[]                @default([])
  features              String[]                @default([])
  certificationNumber   String?                 @map("certification_number")
  floorPlanId           String?                 @map("floor_plan_id")
  floorPlanDate         DateTime?               @map("floor_plan_date") @db.Timestamptz(6)
  floorPlanInterestRate Decimal?                @map("floor_plan_interest_rate") @db.Decimal(5, 2)
  acquisitionType       VehicleAcquisitionType? @map("acquisition_type")
  acquisitionSource     String?                 @map("acquisition_source")
  acquisitionDate       DateTime?               @map("acquisition_date") @db.Timestamptz(6)
  acquisitionCost       Decimal?                @map("acquisition_cost") @db.Decimal(18, 2)
  floorPrice            Decimal?                @map("floor_price") @db.Decimal(18, 2)
  wholesaleValue        Decimal?                @map("wholesale_value") @db.Decimal(18, 2)
  marketValue           Decimal?                @map("market_value") @db.Decimal(18, 2)
  targetPrice           Decimal?                @map("target_price") @db.Decimal(18, 2)
  aiPrice               Decimal?                @map("ai_price") @db.Decimal(18, 2)
  pricingNotes          String?                 @map("pricing_notes")
  appraisalStatus       AppraisalStatus?        @map("appraisal_status")
  lastAppraisedAt       DateTime?               @map("last_appraised_at") @db.Timestamptz(6)
  reconEstimate         Decimal?                @map("recon_estimate") @db.Decimal(18, 2)
  reconActual           Decimal?                @map("recon_actual") @db.Decimal(18, 2)
  reconCompletedAt      DateTime?               @map("recon_completed_at") @db.Timestamptz(6)
  agingBucket           String?                 @map("aging_bucket")
  nextPriceReviewDate   DateTime?               @map("next_price_review_date") @db.Timestamptz(6)
  notes                 String?
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?               @map("deleted_at") @db.Timestamptz(6)
  searchVector          String?                 @map("search_vector")
  appointments          Appointment[]
  appraisals            Appraisal[]
  auctionPurchase       AuctionPurchase?
  dealJackets           DealJacket[]
  dealWorksheets        DealWorksheet[]
  deals                 Deal[]
  marketComps           MarketComp[]
  priceHistory          PriceHistory[]
  reconItems            ReconItem[]
  transportOrders       TransportOrder[]
  histories             VehicleHistory[]
  workflows             VehicleWorkflow[]
  tenant                Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wholesaleListings     WholesaleListing[]
  workflowTasks         WorkflowTask[]

  @@unique([tenantId, stockNumber])
  @@index([tenantId, status])
  @@index([tenantId, make, model])
  @@index([tenantId, acquisitionType])
  @@index([tenantId, appraisalStatus])
  @@index([tenantId])
  @@index([tenantId, searchVector])
  @@map("vehicles")
}

model VehicleHistory {
  id          String             @id @default(cuid())
  tenantId    String             @map("tenant_id")
  vehicleId   String             @map("vehicle_id")
  type        VehicleHistoryType
  date        DateTime           @db.Timestamptz(6)
  description String
  documentUrl String?            @map("document_url")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle     Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([tenantId, vehicleId])
  @@map("vehicle_histories")
}

model Appraisal {
  id               String                   @id @default(cuid())
  tenantId         String                   @map("tenant_id")
