# Database connection strings
DATABASE_URL="postgresql://user:password@localhost:5432/automotive_dms?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/automotive_dms?schema=public"

# Redis for caching and sessions
REDIS_URL="redis://localhost:6379/0"

# Security & Authentication
SESSION_SECRET="replace-with-strong-session-secret"
# Optional legacy secret for backwards compatibility
# JWT_SECRET="replace-with-strong-jwt-secret"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_ISSUER="https://auth.autolytiq.demo"
JWT_AUDIENCE="autolytiq-api"

# Notifications & Messaging
SENDGRID_API_KEY="SG.xxxxxx"
SENDGRID_FROM="no-reply@autolytiq.demo"
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_MESSAGING_SERVICE_SID="MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_CALLER_ID="+15555550100"

# Application URLs
APP_URL="https://app.autolytiq.demo"
API_URL="https://api.autolytiq.demo"
ML_SERVICE_URL="https://ml.autolytiq.demo"
SOCKET_IO_CORS_ORIGIN="https://app.autolytiq.demo"

# Prisma
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/automotive_dms_shadow?schema=public"
