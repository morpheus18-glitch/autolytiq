# Core Application
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5173
API_URL=http://localhost:5000/api

# Database Connections
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autolytiq
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/autolytiq
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autolytiq_shadow
REDIS_URL=redis://localhost:6379

# Session & Authentication
SESSION_SECRET=replace-with-strong-secret
JWT_SECRET=replace-with-jwt-secret
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_ISSUER=https://auth.autolytiq.local
JWT_AUDIENCE=autolytiq-app

# Third-Party Services
SENDGRID_API_KEY=SG.xxxxx
