  id              String    @id @default(uuid())
  dealId          String    @unique
  tenantId        String
  state           String
  federalItems    Json
  stateItems      Json
  lenderItems     Json
  internalItems   Json
  completedItems  Int
  totalItems      Int
  percentComplete Decimal   @db.Decimal(5, 2)
  isComplete      Boolean   @default(false)
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal   DealJacket @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([dealId])
}

model CreditApplication {
  id                String        @id @default(uuid())
  tenantId          String
  dealId            String        @unique
  firstName         String
  middleName        String?
  lastName          String
  ssn               String
  dateOfBirth       DateTime
  phone             String
  email             String
  currentStreet     String
  currentCity       String
  currentState      String
  currentZip        String
  yearsAtAddress    Int
  monthsAtAddress   Int
  residenceType     String
  monthlyPayment    Decimal?      @db.Decimal(18, 2)
  previousStreet    String?
  previousCity      String?
  previousState     String?
  previousZip       String?
  employer          String
  jobTitle          String
  yearsEmployed     Int
  monthsEmployed    Int
  monthlyIncome     Decimal       @db.Decimal(18, 2)
  employerPhone     String
  otherIncomeSource String?
  otherIncomeAmount Decimal?      @db.Decimal(18, 2)
  coApplicant       Json?
  references        Json
  authorizeCredit   Boolean
  certifyAccuracy   Boolean
  privacyConsent    Boolean
  signature         String?
  signedAt          DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal              DealJacket    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  creditReport      CreditReport?

  @@index([tenantId])
  @@index([dealId])
}

model CreditReport {
  id                     String            @id @default(uuid())
  tenantId               String
  creditApplicationId    String            @unique
  bureau                 String
  pullType               String
  experianScore          Int?
  transUnionScore        Int?
  equifaxScore           Int?
  mergedScore            Int?
  scoreRange             String?
  totalAccounts          Int
  openAccounts           Int
  totalRevolvingCredit   Decimal           @db.Decimal(18, 2)
  totalRevolvingBalance  Decimal           @db.Decimal(18, 2)
  utilizationPercent     Decimal           @db.Decimal(5, 2)
  totalInstallmentDebt   Decimal           @db.Decimal(18, 2)
  monthlyDebtObligations Decimal           @db.Decimal(18, 2)
  onTimePaymentPercent   Decimal           @db.Decimal(5, 2)
  late30Days             Int
  late60Days             Int
  late90PlusDays         Int
  collections            Int
  chargeOffs             Int
  bankruptcies           Int
  foreclosures           Int
  hardInquiries          Int
  softInquiries          Int
  tradeLines             Json
  rawResponse            Json
  pdfUrl                 String?
  pulledBy               String
  pulledAt               DateTime          @default(now())
  creditApplication      CreditApplication @relation(fields: [creditApplicationId], references: [id], onDelete: Cascade)
  tenant                 Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([creditApplicationId])
}

model Lender {
  id                  String               @id @default(uuid())
  tenantId            String
  name                String
  type                String
  apiProvider         String
  apiCredentials      Json
  isActive            Boolean              @default(true)
  tierRange           String
  maxTerm             Int
  maxLtv              Decimal              @db.Decimal(6, 3)
  minCreditScore      Int?
  maxCreditScore      Int?
  applicationFee      Decimal?             @db.Decimal(18, 2)
  submissions         LenderSubmission[]
  fundedDeals         DealJacket[]         @relation("DealJacketLender")
  approvalPredictions ApprovalPrediction[]
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model LenderSubmission {
  id              String     @id @default(uuid())
  tenantId        String
  dealId          String
  lenderId        String
  submittedAt     DateTime   @default(now())
  submittedBy     String
  requestPayload  Json
  status          String
  respondedAt     DateTime?
  responsePayload Json?
  amountApproved  Decimal?   @db.Decimal(18, 2)
  apr             Decimal?   @db.Decimal(6, 3)
  buyRate         Decimal?   @db.Decimal(6, 3)
  dealerReserve   Decimal?   @db.Decimal(6, 3)
  maxReserve      Decimal?   @db.Decimal(6, 3)
  term            Int?
  monthlyPayment  Decimal?   @db.Decimal(18, 2)
  declineReason   String?
  declineCode     String?
  stipulations    Json?
  isSelected      Boolean    @default(false)
  selectedAt      DateTime?
  expiresAt       DateTime?
  deal            DealJacket @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lender          Lender     @relation(fields: [lenderId], references: [id], onDelete: Cascade)
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([dealId])
  @@index([status])
}

model FundingChecklist {
  id          String     @id @default(uuid())
  tenantId    String
  dealId      String     @unique
  items       Json
  completed   Boolean    @default(false)
  completedAt DateTime?
  reviewerId  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal        DealJacket @relation(fields: [dealId], references: [id], onDelete: Cascade)
  reviewer    User?      @relation("FundingChecklistReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

model FundingRequest {
  id              String     @id @default(uuid())
  dealId          String     @unique
  tenantId        String
  lenderId        String
  amountRequested Decimal    @db.Decimal(18, 2)
  fundingMethod   String
  bankAccountId   String?
  status          String
  submittedAt     DateTime?
  reviewedAt      DateTime?
  approvedAt      DateTime?
  fundedAt        DateTime?
  fundedAmount    Decimal?   @db.Decimal(18, 2)
  lenderRefNumber String?
  timeline        Json       @default("[]")
  journalEntryId  String?
  createdBy       String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deal            DealJacket @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([dealId])
  @@index([status])
}

model GLAccount {
  id              String        @id @default(cuid())
  tenantId        String
  accountNumber   String
  accountName     String
  accountType     AccountType
  normalBalance   NormalBalance
  parentAccountId String?
  isActive        Boolean       @default(true)
  balance         Decimal?      @db.Decimal(18, 2)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentAccount GLAccount?         @relation("GLAccountHierarchy", fields: [parentAccountId], references: [id], onDelete: SetNull)
  subAccounts   GLAccount[]        @relation("GLAccountHierarchy")
  journalLines  JournalEntryLine[]

  @@unique([tenantId, accountNumber])
  @@index([tenantId, parentAccountId])
}

model JournalEntry {
  id          String        @id @default(cuid())
  tenantId    String
  entryNumber String
  memo        String?
  status      JournalStatus @default(DRAFT)
  postingDate DateTime      @db.Timestamptz(6)
  dealId      String?
  postedById  String
  postedAt    DateTime?     @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal     Deal?              @relation(fields: [dealId], references: [id], onDelete: SetNull)
  postedBy User               @relation(fields: [postedById], references: [id], onDelete: Restrict)
  lines    JournalEntryLine[]

  @@unique([tenantId, entryNumber])
  @@index([tenantId, dealId])
}

model JournalEntryLine {
  id             String   @id @default(cuid())
  tenantId       String
  journalEntryId String
  glAccountId    String
  type           LineType
  amount         Decimal  @db.Decimal(18, 2)
  description    String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  glAccount    GLAccount    @relation(fields: [glAccountId], references: [id], onDelete: Restrict)

  @@index([tenantId, journalEntryId])
  @@index([tenantId, glAccountId])
}

model Commission {
  id             String           @id @default(cuid())
  tenantId       String
  dealId         String
  userId         String
  commissionType CommissionType
  amount         Decimal          @db.Decimal(18, 2)
  rate           Decimal?         @db.Decimal(5, 2)
  status         CommissionStatus @default(PENDING)
  paidDate       DateTime?        @db.Timestamptz(6)
  notes          String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, status])
}

model Report {
  id          String     @id @default(cuid())
  tenantId    String
  name        String
  type        ReportType
  parameters  Json?
  schedule    String?
  lastRunAt   DateTime?  @db.Timestamptz(6)
  createdById String
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User   @relation("ReportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([tenantId, type])
}

model Notification {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  kind      String           @default("system")
  type      NotificationType
  title     String
  message   String
  actionUrl String?
  isRead    Boolean          @default(false)
  readAt    DateTime?        @db.Timestamptz(6)
  payload   Json?
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, isRead])
}

model WorkflowDefinition {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages     WorkflowStage[]
  workflows  VehicleWorkflow[]
  aggregates PipelineAggregate[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model WorkflowStage {
  id           String   @id @default(cuid())
  tenantId     String
  definitionId String
  key          String
  name         String
  position     Int
  slaHours     Int?
  wipLimit     Int?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  definition      WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  incoming        StageTransition[]  @relation("StageTransitionToStage")
  outgoing        StageTransition[]  @relation("StageTransitionFromStage")
  workflows       VehicleWorkflow[]  @relation("VehicleWorkflowCurrentStage")
  tasks           WorkflowTask[]
  transportOrders TransportOrder[]

  @@unique([tenantId, definitionId, key])
  @@index([tenantId, definitionId, position])
}

model VehicleWorkflow {
  id             String    @id @default(cuid())
  tenantId       String
  vehicleId      String
  definitionId   String
  currentStageId String?
  startedAt      DateTime  @default(now()) @db.Timestamptz(6)
  completedAt    DateTime? @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle         Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  definition      WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  currentStage    WorkflowStage?     @relation("VehicleWorkflowCurrentStage", fields: [currentStageId], references: [id], onDelete: SetNull)
  transitions     StageTransition[]
  tasks           WorkflowTask[]
  transportOrders TransportOrder[]

  @@unique([tenantId, vehicleId])
  @@index([tenantId, definitionId])
  @@index([tenantId, currentStageId])
}

model StageTransition {
  id          String   @id @default(cuid())
  tenantId    String
  workflowId  String
  fromStageId String?
  toStageId   String
  at          DateTime @default(now()) @db.Timestamptz(6)
  byUserId    String
  note        String?

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow  VehicleWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  fromStage WorkflowStage?  @relation("StageTransitionFromStage", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage   WorkflowStage   @relation("StageTransitionToStage", fields: [toStageId], references: [id], onDelete: Restrict)
  actor     User            @relation("StageTransitionActor", fields: [byUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, workflowId, at])
}

model WorkflowTask {
  id          String             @id @default(cuid())
  tenantId    String
  workflowId  String
  stageId     String?
  vehicleId   String
  title       String
  description String?
  type        WorkflowTaskType   @default(OTHER)
  status      WorkflowTaskStatus @default(OPEN)
  dueAt       DateTime?          @db.Timestamptz(6)
  assigneeId  String?
  tags        String[]           @default([])
  mentions    String[]           @default([])
  checklist   Json?
  costCents   Int?
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow VehicleWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stage    WorkflowStage?  @relation(fields: [stageId], references: [id], onDelete: SetNull)
  vehicle  Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  assignee User?           @relation("WorkflowTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([tenantId, vehicleId])
  @@index([tenantId, workflowId])
  @@index([tenantId, status])
  @@index([tenantId, type])
}

model TransportOrder {
  id             String               @id @default(cuid())
  tenantId       String
  workflowId     String
  stageId        String?
  vehicleId      String
  vendor         String?
  pickupAddress  String?
  dropoffAddress String?
  scheduledAt    DateTime?            @db.Timestamptz(6)
  status         TransportOrderStatus @default(REQUESTED)
  costCents      Int?
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow VehicleWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stage    WorkflowStage?  @relation(fields: [stageId], references: [id], onDelete: SetNull)
  vehicle  Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([tenantId, vehicleId])
  @@index([tenantId, workflowId])
  @@index([tenantId, status])
}

model PipelineAggregate {
  id                    String   @id @default(cuid())
  tenantId              String
  definitionId          String
  stageKey              String
  bucketStart           DateTime @db.Timestamptz(6)
  avgTimeInStageMinutes Int      @default(0)
  completedCount        Int      @default(0)
  slaHitRate            Decimal? @db.Decimal(5, 2)
  wipMax                Int      @default(0)
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @db.Timestamptz(6)

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, definitionId, stageKey, bucketStart])
  @@index([tenantId, bucketStart])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  resource  String
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, resource])
  @@index([tenantId, userId])
}

model SystemSetting {
  id          String   @id @default(cuid())
  tenantId    String
  key         String
  value       Json
  updatedById String
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedBy User   @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([tenantId, key])
  @@index([tenantId])
}
