generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                   String                  @id @default(cuid())
  name                 String
  subdomain            String                  @unique
  plan                 TenantPlan              @default(BASIC)
  status               TenantStatus            @default(ACTIVE)
  settings             Json                    @default("{}")
  billingEmail         String                  @map("billing_email")
  subscriptionEndsAt   DateTime?               @map("subscription_ends_at") @db.Timestamptz(6)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  activities           Activity[]
  aiCounterOffers      AICounterOffer[]
  appointments         Appointment[]
  appraisals           Appraisal[]
  approvalPredictions  ApprovalPrediction[]
  auctionPurchases     AuctionPurchase[]
  auditLogs            AuditLog[]
  automationExecutions AutomationExecution[]
  automations          Automation[]
  commissions          Commission[]
  communications       Communication[]
  complianceChecklists ComplianceChecklist[]
  contracts            Contract[]
  counterOffers        CounterOffer[]
  creditApplications   CreditApplication[]
  creditReports        CreditReport[]
  creditSubmissions    CreditSubmissionDraft[]
  customerActivities   CustomerActivity[]
  customerInteractions CustomerInteraction[]
  customerVehicles     CustomerVehicle[]
  customers            Customer[]
  dealActivities       DealActivity[]
  dealEvents           DealEvent[]
  dealFiProducts       DealFIProduct[]
  dealJackets          DealJacket[]
  dealOptimizations    DealOptimization[]
  dealVersions         DealVersion[]
  dealWorksheets       DealWorksheet[]
  deals                Deal[]
  emailTemplates       EmailTemplate[]
  fiProducts           FIProduct[]
  financeProducts      FinanceProduct[]
  fundingChecklists    FundingChecklist[]
  glAccounts           GLAccount[]
  journalEntries       JournalEntry[]
  journalEntryLines    JournalEntryLine[]
  leadActivities       LeadActivity[]
  leadScores           LeadScore[]
  leads                Lead[]
  lenderSubmissions    LenderSubmission[]
  lenders              Lender[]
  locations            Location[]
  marketComps          MarketComp[]
  menuConfigurations   MenuConfiguration[]
  mlFeatureCaches      MLFeatureCache[]
  notifications        Notification[]
  outboxEvents         Outbox[]
  pipelineAggregates   PipelineAggregate[]
  priceHistories       PriceHistory[]
  reconItems           ReconItem[]
  reports              Report[]
  rolePresets          RolePreset[]
  serviceLineItems     ServiceLineItem[]
  serviceOrders        ServiceOrder[]
  smsTemplates         SMSTemplate[]
  stageTransitions     StageTransition[]
  systemSettings       SystemSetting[]
  tenantSettings       TenantSettings?
  tradeIns             TradeIn[]
  transportOrders      TransportOrder[]
  users                User[]
  vehicleHistories     VehicleHistory[]
  vehicleWorkflows     VehicleWorkflow[]
  vehicles             Vehicle[]
  wholesaleListings    WholesaleListing[]
  workflowDefinitions  WorkflowDefinition[]
  workflowStages       WorkflowStage[]
  workflowTasks        WorkflowTask[]
  dashboardLayouts     DashboardLayout[]
  searchQueries        SearchQuery[]
  popularSearches      PopularSearch[]

  @@map("tenants")
}

model User {
  id                        String                @id @default(cuid())
  tenantId                  String                @map("tenant_id")
  email                     String
  password                  String
  firstName                 String                @map("first_name")
  lastName                  String                @map("last_name")
  phone                     String?
  role                      UserRole              @default(SALES)
  rolePresetId              String?               @map("role_preset_id")
  permissions               Json                  @default(dbgenerated("jsonb_build_array()"))
  customPermissions         Json?                 @default(dbgenerated("jsonb_build_array()")) @map("custom_permissions")
  status                    UserStatus            @default(ACTIVE)
  isSuperAdmin              Boolean               @default(false) @map("is_super_admin")
  lastLoginAt               DateTime?             @map("last_login_at") @db.Timestamptz(6)
  createdAt                 DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                 DateTime?             @map("deleted_at") @db.Timestamptz(6)
  activities                Activity[]
  aiCounterOffers           AICounterOffer[]
  appointments              Appointment[]         @relation("AppointmentAssignedTo")
  appraisalsCreated         Appraisal[]           @relation("AppraisalsAppraiser")
  appraisalsReviewed        Appraisal[]           @relation("AppraisalsManager")
  auditLogs                 AuditLog[]
  commissions               Commission[]
  communications            Communication[]
  counterOffersHandled      CounterOffer[]        @relation("CounterOfferHandledBy")
  customerActivities        CustomerActivity[]
  interactions              CustomerInteraction[]
  customers                 Customer[]            @relation("CustomerAssignedTo")
  createdCustomers          Customer[]            @relation("CustomerCreator")
  dealActivities            DealActivity[]
  dealEventsCreated         DealEvent[]
  dealJacketsAsFinance      DealJacket[]          @relation("DealJacketFIManager")
  dealJacketsAsSales        DealJacket[]          @relation("DealJacketSalesperson")
  dealOptimizationsRun      DealOptimization[]    @relation("DealOptimizationRunBy")
  dealVersionsCreated       DealVersion[]         @relation("DealVersionCreatedBy")
  dealWorksheets            DealWorksheet[]       @relation("DealWorksheetSalesperson")
  deliveredDeals            Deal[]                @relation("DealDeliveredBy")
  fiDeals                   Deal[]                @relation("FinanceManagerDeals")
  managedDeals              Deal[]                @relation("DealSalesManager")
  salesDeals                Deal[]                @relation("SalesPersonDeals")
  fundingChecklistsReviewed FundingChecklist[]    @relation("FundingChecklistReviewer")
  journalEntries            JournalEntry[]
  leadActivities            LeadActivity[]
  leadsAssigned             Lead[]                @relation("LeadAssignedTo")
  leadsOwned                Lead[]                @relation("LeadOwner")
  notifications             Notification[]
  priceChanges              PriceHistory[]        @relation("PriceHistoryChangedBy")
  reports                   Report[]              @relation("ReportCreatedBy")
  advisedServiceOrders      ServiceOrder[]        @relation("ServiceAdvisor")
  techServiceOrders         ServiceOrder[]        @relation("ServiceTechnician")
  stageTransitions          StageTransition[]     @relation("StageTransitionActor")
  systemSettings            SystemSetting[]
  appraisedTradeIns         TradeIn[]             @relation("TradeInAppraiser")
  tenant                    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedWorkflowTasks     WorkflowTask[]          @relation("WorkflowTaskAssignee")
  dashboardLayouts          DashboardLayout[]
  widgetPreferences         UserWidgetPreference[]
  searchQueries             SearchQuery[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([isSuperAdmin])
  @@map("users")
}

model Customer {
  id                     String                 @id @default(cuid())
  tenantId               String                 @map("tenant_id")
  firstName              String                 @map("first_name")
  middleName             String?                @map("middle_name")
  lastName               String                 @map("last_name")
  suffix                 String?                @map("suffix")
  email                  String?
  phone                  String?
  phoneSecondary         String?                @map("phone_secondary")
  mobile                 String?
  dateOfBirth            DateTime?              @map("date_of_birth") @db.Date
  licenseNumber          String?                @map("drivers_license_number")
  licenseState           String?                @map("drivers_license_state")
  licenseExpiry          DateTime?              @map("license_expiry") @db.Date
  ssn                    String?
  addressStreet          String?                @map("address_street")
  addressCity            String?                @map("address_city")
  addressState           String?                @map("address_state")
  addressZip             String?                @map("address_zip")
  addressCountry         String?                @map("address_country")
  county                 String?                @map("county")
  preferredContactMethod PreferredContactMethod @default(EMAIL) @map("preferred_contact_method")
  leadSource             LeadSource             @default(WEBSITE) @map("lead_source")
  leadStatus             LeadStatus             @default(NEW) @map("lead_status")
  leadScore              Int                    @default(0) @map("lead_score")
  creditScore            Int?                   @map("credit_score")
  assignedToUserId       String?                @map("assigned_to_user_id")
  employerName           String?                @map("employer_name")
  employerPhone          String?                @map("employer_phone")
  monthlyIncome          Int?                   @map("monthly_income")
  housingStatus          String?                @map("housing_status")
  monthlyPayment         Int?                   @map("monthly_payment")
  yearsAtAddress         Int?                   @map("years_at_address")
  consentTcpa            Boolean                @default(false) @map("consent_tcpa")
  consentCredit          Boolean                @default(false) @map("consent_credit")
  consentDate            DateTime?              @map("consent_date") @db.Timestamptz(6)
  coBuyerFirstName       String?                @map("co_buyer_first_name")
  coBuyerLastName        String?                @map("co_buyer_last_name")
  coBuyerEmail           String?                @map("co_buyer_email")
  coBuyerPhone           String?                @map("co_buyer_phone")
  coBuyerDateOfBirth     DateTime?              @map("co_buyer_date_of_birth") @db.Date
  coBuyerSsn             String?                @map("co_buyer_ssn")
  coBuyerEmployer        String?                @map("co_buyer_employer")
  coBuyerIncome          Int?                   @map("co_buyer_income")
  source                 LeadSource?            @map("source")
  tags                   String[]               @default([])
  notes                  String?
  lifetimeValue          Decimal                @default(0) @map("lifetime_value") @db.Decimal(18, 2)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?              @map("deleted_at") @db.Timestamptz(6)
  searchVector           String?                @map("search_vector")
  isActive               Boolean                @default(true) @map("is_active")
  createdById            String?                @map("created_by_id")
  activities             Activity[]
  appointments           Appointment[]
  communications         Communication[]
  customerActivities     CustomerActivity[]
  interactions           CustomerInteraction[]
  vehicles               CustomerVehicle[]
  assignedToUser         User?                  @relation("CustomerAssignedTo", fields: [assignedToUserId], references: [id])
  createdBy              User?                  @relation("CustomerCreator", fields: [createdById], references: [id])
  tenant                 Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dealJackets            DealJacket[]
  dealWorksheets         DealWorksheet[]
  deals                  Deal[]
  leads                  Lead[]
  serviceOrders          ServiceOrder[]
  tradeIns               TradeIn[]

  @@index([tenantId, leadStatus])
  @@index([tenantId, assignedToUserId])
  @@index([tenantId])
  @@index([tenantId, searchVector])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@map("customers")
}

model CustomerInteraction {
  id          String               @id @default(cuid())
  tenantId    String               @map("tenant_id")
  customerId  String               @map("customer_id")
  userId      String               @map("user_id")
  type        InteractionType
  direction   InteractionDirection
  subject     String?
  notes       String?
  duration    Int?
  scheduledAt DateTime?            @map("scheduled_at") @db.Timestamptz(6)
  completedAt DateTime?            @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?            @map("deleted_at") @db.Timestamptz(6)
  customer    Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@index([tenantId, scheduledAt])
  @@map("customer_interactions")
}

model CustomerActivity {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  customerId  String   @map("customer_id")
  type        String   @map("type")
  direction   String?  @map("direction")
  subject     String?  @map("subject")
  description String?  @map("description")
  performedBy String?  @map("performed_by")
  duration    Int?     @map("duration")
  metadata    Json?    @map("metadata")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  customer    Customer @relation(fields: [customerId], references: [id])
  performer   User?    @relation(fields: [performedBy], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId, createdAt])
  @@map("customer_activities")
}

model Lead {
  id                  String          @id @default(cuid())
  tenantId            String          @map("tenant_id")
  customerId          String?         @map("customer_id")
  assignedToId        String?         @map("assigned_to_id")
  ownerId             String?         @map("owner_id")
  firstName           String?         @map("first_name")
  lastName            String?         @map("last_name")
  email               String?
  phone               String?
  status              LeadStatus      @default(NEW)
  source              LeadSource      @default(WEBSITE)
  priority            LeadPriority    @default(MEDIUM)
  rating              Int?
  score               Int?
  smsOptOut           Boolean         @default(false) @map("sms_opt_out")
  emailOptOut         Boolean         @default(false) @map("email_opt_out")
  callOptOut          Boolean         @default(false) @map("call_opt_out")
  isArchived          Boolean         @default(false) @map("is_archived")
  isConverted         Boolean         @default(false) @map("is_converted")
  lastActivityAt      DateTime?       @map("last_activity_at") @db.Timestamptz(6)
  lastCommunicationAt DateTime?       @map("last_communication_at") @db.Timestamptz(6)
  nextActionAt        DateTime?       @map("next_action_at") @db.Timestamptz(6)
  convertedAt         DateTime?       @map("converted_at") @db.Timestamptz(6)
  description         String?
  tags                String[]        @default([])
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  activities          Activity[]
  appointments        Appointment[]
  communications      Communication[]
  leadActivities      LeadActivity[]
  scores              LeadScore[]
  assignedTo          User?           @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  customer            Customer?       @relation(fields: [customerId], references: [id])
  owner               User?           @relation("LeadOwner", fields: [ownerId], references: [id])
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, assignedToId])
  @@index([tenantId, ownerId])
  @@index([tenantId, source])
  @@index([tenantId, isArchived, status])
  @@index([tenantId, createdAt])
  @@map("leads")
}

model LeadActivity {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  leadId      String   @map("lead_id")
  type        String   @map("type")
  description String?  @map("description")
  performedBy String?  @map("performed_by")
  metadata    Json?    @map("metadata")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lead        Lead     @relation(fields: [leadId], references: [id])
  performer   User?    @relation(fields: [performedBy], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId, createdAt])
  @@map("lead_activities")
}

model Activity {
  id                     String          @id @default(cuid())
  tenantId               String          @map("tenant_id")
  leadId                 String?         @map("lead_id")
  customerId             String?         @map("customer_id")
  userId                 String?         @map("user_id")
  type                   ActivityType
  status                 ActivityStatus  @default(PENDING)
  subject                String?
  description            String?
  outcome                String?
  metadata               Json?
  opened                 Boolean         @default(false)
  clicked                Boolean         @default(false)
  dueAt                  DateTime?       @map("due_at") @db.Timestamptz(6)
  startedAt              DateTime?       @map("started_at") @db.Timestamptz(6)
  completedAt            DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer               Customer?       @relation(fields: [customerId], references: [id])
  lead                   Lead?           @relation(fields: [leadId], references: [id])
  tenant                 Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                   User?           @relation(fields: [userId], references: [id])
  followUpForAppointment Appointment?    @relation("AppointmentFollowUpTask")
  communications         Communication[]

  @@index([tenantId, leadId])
  @@index([tenantId, userId])
  @@index([tenantId, dueAt])
  @@index([tenantId, status])
  @@map("activities")
}

model Appointment {
  id             String            @id @default(cuid())
  tenantId       String            @map("tenant_id")
  leadId         String?           @map("lead_id")
  customerId     String?           @map("customer_id")
  assignedToId   String?           @map("assigned_to_id")
  vehicleId      String?           @map("vehicle_id")
  title          String
  notes          String?
  type           AppointmentType
  status         AppointmentStatus @default(SCHEDULED)
  location       String?
  locationId     String?           @map("location_id")
  timeZone       String?           @default("UTC") @map("time_zone")
  startAt        DateTime          @map("start_at") @db.Timestamptz(6)
  endAt          DateTime?         @map("end_at") @db.Timestamptz(6)
  checkedInAt    DateTime?         @map("checked_in_at") @db.Timestamptz(6)
  completedAt    DateTime?         @map("completed_at") @db.Timestamptz(6)
  cancelledAt    DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  noShowAt       DateTime?         @map("no_show_at") @db.Timestamptz(6)
  outcome        String?
  followUpTaskId String?           @unique @map("follow_up_task_id")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignedTo     User?             @relation("AppointmentAssignedTo", fields: [assignedToId], references: [id])
  customer       Customer?         @relation(fields: [customerId], references: [id])
  followUpTask   Activity?         @relation("AppointmentFollowUpTask", fields: [followUpTaskId], references: [id])
  lead           Lead?             @relation(fields: [leadId], references: [id])
  locationRef    Location?         @relation(fields: [locationId], references: [id])
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle        Vehicle?          @relation(fields: [vehicleId], references: [id])

  @@index([tenantId, startAt])
  @@index([tenantId, status])
  @@index([tenantId, leadId])
  @@index([tenantId, assignedToId])
  @@index([tenantId, vehicleId])
  @@index([tenantId, locationId])
  @@map("appointments")
}

model ServiceOrder {
  id                String             @id @default(cuid())
  tenantId          String             @map("tenant_id")
  roNumber          String             @map("ro_number")
  customerId        String             @map("customer_id")
  vehicleId         String             @map("vehicle_id")
  locationId        String?            @map("location_id")
  status            ServiceOrderStatus @default(DRAFT)
  type              ServiceType        @map("type")
  advisorId         String?            @map("advisor_id")
  technicianId      String?            @map("technician_id")
  scheduledDate     DateTime?          @map("scheduled_date") @db.Timestamptz(6)
  startedAt         DateTime?          @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime?          @map("completed_at") @db.Timestamptz(6)
  promisedDate      DateTime?          @map("promised_date") @db.Timestamptz(6)
  mileageIn         Int?               @map("mileage_in")
  mileageOut        Int?               @map("mileage_out")
  customerConcern   String?            @map("customer_concern")
  causeOfFailure    String?            @map("cause_of_failure")
  correction        String?            @map("correction")
  laborCents        Int?               @map("labor_cents")
  partsCents        Int?               @map("parts_cents")
  subletCents       Int?               @map("sublet_cents")
  shopSuppliesCents Int?               @map("shop_supplies_cents")
  subtotalCents     Int?               @map("subtotal_cents")
  taxCents          Int?               @map("tax_cents")
  totalCents        Int?               @map("total_cents")
  isPaid            Boolean            @default(false) @map("is_paid")
  paidAt            DateTime?          @map("paid_at") @db.Timestamptz(6)
  notes             String?            @map("notes")
  internalNotes     String?            @map("internal_notes")
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  lineItems         ServiceLineItem[]
  advisor           User?              @relation("ServiceAdvisor", fields: [advisorId], references: [id])
  customer          Customer           @relation(fields: [customerId], references: [id])
  location          Location?          @relation(fields: [locationId], references: [id])
  technician        User?              @relation("ServiceTechnician", fields: [technicianId], references: [id])
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle           Vehicle            @relation(fields: [vehicleId], references: [id])

  @@unique([tenantId, roNumber])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, vehicleId])
  @@index([tenantId, advisorId])
  @@map("service_orders")
}

model ServiceLineItem {
  id             String       @id @default(cuid())
  tenantId       String       @map("tenant_id")
  serviceOrderId String       @map("service_order_id")
  type           String       @map("type")
  description    String?      @map("description")
  hours          Float?       @map("hours")
  rateCents      Int?         @map("rate_cents")
  amountCents    Int          @map("amount_cents")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, serviceOrderId])
  @@map("service_line_items")
}

model LeadScore {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  leadId     String   @map("lead_id")
  modelKey   String   @map("model_key")
  score      Int
  scoreDelta Int?     @map("score_delta")
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId])
  @@index([tenantId, createdAt])
  @@map("lead_scores")
}

model Communication {
  id         String                 @id @default(cuid())
  tenantId   String                 @map("tenant_id")
  type       CommunicationType
  direction  CommunicationDirection
  to         String
  from       String
  subject    String?
  body       String?
  providerId String?                @map("provider_id")
  status     CommunicationStatus?
  metadata   Json?
  leadId     String?                @map("lead_id")
  customerId String?                @map("customer_id")
  activityId String?                @map("activity_id")
  userId     String?                @map("user_id")
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  activity   Activity?              @relation(fields: [activityId], references: [id])
  customer   Customer?              @relation(fields: [customerId], references: [id])
  lead       Lead?                  @relation(fields: [leadId], references: [id])
  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?                  @relation(fields: [userId], references: [id])

  @@index([tenantId, type])
  @@index([tenantId, leadId])
  @@index([tenantId, createdAt])
  @@map("communications")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  subject   String
  html      String
  text      String?
