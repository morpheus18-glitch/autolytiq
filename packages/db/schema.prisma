  costCents   Int?               @map("cost_cents")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignee    User?              @relation("WorkflowTaskAssignee", fields: [assigneeId], references: [id])
  stage       WorkflowStage?     @relation(fields: [stageId], references: [id])
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle     Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  workflow    VehicleWorkflow    @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([tenantId, vehicleId])
  @@index([tenantId, workflowId])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@map("workflow_tasks")
}

model TransportOrder {
  id             String               @id @default(cuid())
  tenantId       String               @map("tenant_id")
  workflowId     String               @map("workflow_id")
  stageId        String?              @map("stage_id")
  vehicleId      String               @map("vehicle_id")
  vendor         String?
  pickupAddress  String?              @map("pickup_address")
  dropoffAddress String?              @map("dropoff_address")
  scheduledAt    DateTime?            @map("scheduled_at") @db.Timestamptz(6)
  status         TransportOrderStatus @default(REQUESTED)
  costCents      Int?                 @map("cost_cents")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  stage          WorkflowStage?       @relation(fields: [stageId], references: [id])
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle        Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  workflow       VehicleWorkflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([tenantId, vehicleId])
  @@index([tenantId, workflowId])
  @@index([tenantId, status])
  @@map("transport_orders")
}

model PipelineAggregate {
  id                    String             @id @default(cuid())
  tenantId              String             @map("tenant_id")
  definitionId          String             @map("definition_id")
  stageKey              String             @map("stage_key")
  bucketStart           DateTime           @map("bucket_start") @db.Timestamptz(6)
  avgTimeInStageMinutes Int                @default(0) @map("avg_time_in_stage_minutes")
  completedCount        Int                @default(0) @map("completed_count")
  slaHitRate            Decimal?           @map("sla_hit_rate") @db.Decimal(5, 2)
  wipMax                Int                @default(0) @map("wip_max")
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  definition            WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, definitionId, stageKey, bucketStart])
  @@index([tenantId, bucketStart])
  @@map("pipeline_aggregates")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String?  @map("user_id")
  action    String
  resource  String
  details   Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([tenantId, resource])
  @@index([tenantId, userId])
  @@map("audit_logs")
}

model SystemSetting {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  key         String
  value       Json
  updatedById String   @map("updated_by_id")
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedBy   User     @relation(fields: [updatedById], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("system_settings")
}

model Outbox {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  topic       String
  eventType   String    @map("event_type")
  payload     Json
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([publishedAt])
  @@index([occurredAt])
  @@map("outbox")
}

model DealEvent {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  dealId     String   @map("deal_id")
  eventType  String   @map("event_type")
  payload    Json
  prevHash   String?  @map("prev_hash")
  thisHash   String   @unique @map("this_hash")
  userId     String?  @map("user_id")
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([dealId])
  @@index([occurredAt])
  @@map("deal_events")
}

model MLFeatureCache {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  featureType  String   @map("feature_type")
  features     Json
  prediction   Json
  confidence   Decimal? @db.Decimal(5, 4)
  modelVersion String   @map("model_version")
  computedAt   DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entityType, entityId, featureType, modelVersion])
  @@index([tenantId])
  @@index([expiresAt])
  @@map("ml_feature_cache")
}

