# Default connection string for local development environments that only expose
# port 80 (e.g. Replit). A lightweight TCP proxy defined in
# docker-compose.override.yml forwards port 80 to the internal Postgres port so
# Prisma commands keep working out of the box. Override these values in your
# environment if you need a different database target.
DATABASE_URL=postgresql://autolytiq:autolytiq@localhost:80/autolytiq?schema=public
DIRECT_URL=postgresql://autolytiq:autolytiq@localhost:80/autolytiq?schema=public
