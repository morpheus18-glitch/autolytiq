model AICounterOffer {
  id                   String    @id @default(cuid())
  tenantId             String    @map("tenant_id")
  dealId               String    @map("deal_id")
  userId               String    @map("user_id")
  customerPayment      Decimal   @map("customer_payment") @db.Decimal(10, 2)
  customerDownPayment  Decimal   @map("customer_down_payment") @db.Decimal(10, 2)
  customerTermMonths   Int       @map("customer_term_months")
  customerApr          Decimal?  @map("customer_apr") @db.Decimal(5, 2)
  vehicleCost          Decimal   @map("vehicle_cost") @db.Decimal(10, 2)
  vehicleMsrp          Decimal   @map("vehicle_msrp") @db.Decimal(10, 2)
  vehicleDaysOnLot     Int       @map("vehicle_days_on_lot")
  tradeInValue         Decimal   @default(0.00) @map("trade_in_value") @db.Decimal(10, 2)
  tradeInPayoff        Decimal   @default(0.00) @map("trade_in_payoff") @db.Decimal(10, 2)
  customerCreditScore  Int?      @map("customer_credit_score")
  customerDebtToIncome Decimal?  @map("customer_debt_to_income") @db.Decimal(5, 2)
  requestedAt          DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  processedAt          DateTime? @map("processed_at") @db.Timestamptz(6)
  modelVersion         String    @default("v1.0") @map("model_version")
  confidenceScore      Decimal?  @map("confidence_score") @db.Decimal(3, 2)
  processingTimeMs     Int?      @map("processing_time_ms")
  counterOptions       Json      @default("[]") @map("counter_options")
  selectedOptionIndex  Int?      @map("selected_option_index")
  selectedAt           DateTime? @map("selected_at") @db.Timestamptz(6)
  outcome              String?
  outcomeRecordedAt    DateTime? @map("outcome_recorded_at") @db.Timestamptz(6)
  actualProfit         Decimal?  @map("actual_profit") @db.Decimal(10, 2)
  feedbackHelpful      Boolean?  @map("feedback_helpful")
  feedbackComment      String?   @map("feedback_comment")
  feedbackSubmittedAt  DateTime? @map("feedback_submitted_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deal                 Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([dealId])
  @@index([userId])
  @@index([requestedAt(sort: Desc)])
  @@index([outcome])
  @@map("ai_counter_offers")
}

