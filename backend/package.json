{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "ts-node-dev --respawn src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:push": "prisma db push",
    "db:seed": "ts-node --project tsconfig.seed.json prisma/seed.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:gen": "prisma generate",
    "seed": "ts-node --project tsconfig.seed.json prisma/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.653.0",
    "@aws-sdk/lib-storage": "^3.653.0",
    "@aws-sdk/s3-request-presigner": "^3.653.0",
    "@faker-js/faker": "^10.1.0",
    "@prisma/client": "^5.0.0",
    "@sendgrid/mail": "^8.1.5",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fast-csv": "^5.0.5",
    "helmet": "^7.0.0",
    "http-proxy-middleware": "^3.0.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.0",
    "pino": "^9.3.2",
    "socket.io": "^4.7.5",
    "twilio": "^5.3.3",
    "zod": "^3.23.8",
    "axios": "^1.6.8",
    "ioredis": "^5.4.1",
    "prom-client": "^15.1.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.12",
    "@types/pdfkit": "^0.12.9",
    "@types/supertest": "^2.0.16",
    "@types/node": "^20.11.30",
    "prisma": "^5.0.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.4"
