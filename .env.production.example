# ==============================================================================
# AUTOLYTIQ PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file and configure with your production values
# NEVER commit actual secrets to version control
# ==============================================================================

# ------------------------------------------------------------------------------
# DEPLOYMENT MODE
# ------------------------------------------------------------------------------
DEPLOY_MODE=replit
NODE_ENV=production

# ------------------------------------------------------------------------------
# DATABASE (REQUIRED)
# ------------------------------------------------------------------------------
# Use Replit PostgreSQL, Neon, or Supabase
# Example: postgresql://user:password@host:5432/autolytiq?schema=public
DATABASE_URL=
DIRECT_URL=

# ------------------------------------------------------------------------------
# SECURITY (REQUIRED)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
SESSION_SECRET=
JWT_SECRET=

# ------------------------------------------------------------------------------
# APPLICATION URLS (REQUIRED)
# ------------------------------------------------------------------------------
# Replace with your actual Replit deployment URL
APP_URL=https://your-repl-name.replit.app
API_URL=https://your-repl-name.replit.app
VITE_API_URL=https://your-repl-name.replit.app

# ------------------------------------------------------------------------------
# SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5000
SOCKET_IO_CORS_ORIGIN=https://your-repl-name.replit.app

# ------------------------------------------------------------------------------
# REDIS (OPTIONAL - Required for background jobs)
# ------------------------------------------------------------------------------
# Use Upstash, Redis Cloud, or Replit Redis
# Example: redis://default:password@host:6379
REDIS_URL=

# ------------------------------------------------------------------------------
# EMAIL SERVICE (OPTIONAL)
# ------------------------------------------------------------------------------
# SendGrid (Recommended)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_WEBHOOK_SIGNING_KEY=

# Alternative: SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ------------------------------------------------------------------------------
# SMS SERVICE (OPTIONAL)
# ------------------------------------------------------------------------------
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# ------------------------------------------------------------------------------
# CLOUD STORAGE (OPTIONAL - Required for documents/images)
# ------------------------------------------------------------------------------
# AWS S3 or compatible (Cloudflare R2, DigitalOcean Spaces, etc.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=autolytiq-production
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.amazonaws.com
S3_CLOUDFRONT_URL=

# ------------------------------------------------------------------------------
# AI / ML SERVICES (OPTIONAL)
# ------------------------------------------------------------------------------
# OpenAI
OPENAI_API_KEY=

# ML Service URL (if running separate ML service)
ML_SERVICE_URL=
ML_SERVICE_TOKEN=

# ------------------------------------------------------------------------------
# PAYMENT PROCESSING (OPTIONAL)
# ------------------------------------------------------------------------------
# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# CREDIT BUREAU INTEGRATION (OPTIONAL)
# ------------------------------------------------------------------------------
# Experian
EXPERIAN_API_URL=https://api.experian.com
EXPERIAN_API_KEY=
EXPERIAN_CLIENT_ID=
EXPERIAN_CLIENT_SECRET=

# TransUnion
TRANSUNION_API_URL=https://api.transunion.com
TRANSUNION_API_KEY=

# Equifax
EQUIFAX_API_URL=https://api.equifax.com
EQUIFAX_API_KEY=

# ------------------------------------------------------------------------------
# E-SIGNATURE SERVICE (OPTIONAL)
# ------------------------------------------------------------------------------
# DocuSign
DOCUSIGN_BASE_URL=https://na3.docusign.net
DOCUSIGN_INTEGRATOR_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_AUTH_JWT=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_REDIRECT_URL=https://your-repl-name.replit.app/api/integrations/docusign/callback

# ------------------------------------------------------------------------------
# ANALYTICS (OPTIONAL)
# ------------------------------------------------------------------------------
# ClickHouse
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=9440
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Google Analytics
VITE_GA_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# SECURITY & ENCRYPTION (OPTIONAL)
# ------------------------------------------------------------------------------
# For encrypting sensitive data (SSN, credit info)
# Generate with: openssl rand -hex 32
CREDIT_ENCRYPTION_KEY=

# ClamAV for file scanning (if available)
CLAMAV_HOST=
CLAMAV_PORT=3310

# ------------------------------------------------------------------------------
# SOCIAL MEDIA ASSETS (OPTIONAL)
# ------------------------------------------------------------------------------
# Pexels for stock images
PEXELS_API_KEY=

# ------------------------------------------------------------------------------
# FEATURE FLAGS (OPTIONAL)
# ------------------------------------------------------------------------------
# Enable/disable features
ENABLE_ML_FEATURES=true
ENABLE_CAMPAIGNS=true
ENABLE_PROJECTS=true
ENABLE_TICKETING=true
ENABLE_INTEGRATIONS=true
ENABLE_DOCUMENTS=true

# ------------------------------------------------------------------------------
# LOGGING & MONITORING (OPTIONAL)
# ------------------------------------------------------------------------------
LOG_LEVEL=info
ENABLE_QUERY_LOGGING=false
ENABLE_REQUEST_LOGGING=true

# ------------------------------------------------------------------------------
# RATE LIMITING (OPTIONAL)
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------------------------
# CORS (OPTIONAL)
# ------------------------------------------------------------------------------
CORS_ORIGIN=https://your-repl-name.replit.app

# ==============================================================================
# DEPLOYMENT NOTES
# ==============================================================================
#
# 1. REQUIRED VARIABLES (Must set these):
#    - DATABASE_URL
#    - DIRECT_URL
#    - SESSION_SECRET (32+ characters)
#    - JWT_SECRET
#    - APP_URL
#    - API_URL
#    - VITE_API_URL
#
# 2. RECOMMENDED FOR PRODUCTION:
#    - REDIS_URL (for background jobs)
#    - SENDGRID_API_KEY or SMTP settings (for emails)
#    - AWS credentials (for file storage)
#
# 3. OPTIONAL BUT USEFUL:
#    - TWILIO credentials (for SMS)
#    - OPENAI_API_KEY (for AI features)
#    - STRIPE credentials (for payments)
#    - Credit bureau credentials (for automotive finance)
#
# 4. SECURITY:
#    - Never commit this file with real values
#    - Use Replit Secrets for sensitive values
#    - Rotate secrets regularly
#    - Use strong random values for SESSION_SECRET and JWT_SECRET
#
# 5. GENERATE SECRETS:
#    Session Secret:  openssl rand -base64 32
#    JWT Secret:      openssl rand -base64 32
#    Encryption Key:  openssl rand -hex 32
#
# ==============================================================================
